<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Hand-drawn 24x24 line icons, stroked (not filled) via the "Icon" Path style in App.axaml.
    These replace the emoji glyphs that used to sit in TextBlocks: several of them (✏️ 🗑️ 👁️ 📋 🔑
    🚪 🔄 💾) render as tofu boxes on systems without a color-emoji font, so the app looked broken
    depending on the OS. Vector paths render identically everywhere.
  -->
  <StreamGeometry x:Key="IconExplorer">M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M12,7 A5,5 0 1 1 11.99,7 Z M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M5,19 L7,17 M17,7 L19,5</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3,6 L9,6 L11,8 L21,8 L21,18 L3,18 Z</StreamGeometry>
  <StreamGeometry x:Key="IconFile">M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7</StreamGeometry>
  <StreamGeometry x:Key="IconKey">M7,12 A3,3 0 1 1 6.99,12 Z M10,12 L21,12 M17,12 L17,15 M20,12 L20,16</StreamGeometry>
  <StreamGeometry x:Key="IconLogout">M14,3 L5,3 L5,21 L14,21 M9,12 L21,12 M17,8 L21,12 L17,16</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M4,12 A8,8 0 1 1 8,18.5 M8,21 L8,17.5 L4.5,17.5</StreamGeometry>
  <StreamGeometry x:Key="IconArrowLeft">M19,12 L5,12 M11,6 L5,12 L11,18</StreamGeometry>
  <StreamGeometry x:Key="IconFolderPlus">M3,6 L9,6 L11,8 L21,8 L21,18 L3,18 Z M15,11 L15,15 M13,13 L17,13</StreamGeometry>
  <StreamGeometry x:Key="IconUpload">M12,21 L12,9 M7,13 L12,8 L17,13 M4,21 L20,21</StreamGeometry>
  <StreamGeometry x:Key="IconDownload">M12,3 L12,15 M7,11 L12,16 L17,11 M4,21 L20,21</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M5,4 L15,4 L15,14 L5,14 Z M9,8 L19,8 L19,20 L9,20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPencil">M4,20 L4,17 L15,6 L18,9 L7,20 Z M13,8 L16,11</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L7,21 L17,21 L17,7 M10,11 L10,17 M14,11 L14,17</StreamGeometry>
  <StreamGeometry x:Key="IconSave">M5,3 L16,3 L19,6 L19,21 L5,21 Z M8,3 L8,9 L15,9 L15,3 M8,21 L8,14 L16,14 L16,21</StreamGeometry>
  <StreamGeometry x:Key="IconClear">M12,3 A9,9 0 1 1 11.99,3 Z M9,9 L15,15 M15,9 L9,15</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M12,4 L12,20 M4,12 L20,12</StreamGeometry>
  <StreamGeometry x:Key="IconEye">M2,12 C5,5 19,5 22,12 C19,19 5,19 2,12 Z M12,9 A3,3 0 1 1 11.99,9 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPlay">M6,4 L20,12 L6,20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,16.5 L12,17</StreamGeometry>
</ResourceDictionary>
