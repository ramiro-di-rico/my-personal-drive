<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon></ApplicationIcon>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <TrimMode>partial</TrimMode>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <!-- ItemsRepeater is NOT in the core Avalonia package; it ships separately. Needed because
         WrapPanel does not virtualize, and the icons/gallery modes would otherwise materialize a
         tile per item in a folder of any size (docs/PLAN-BROWSER-VIEWS.md §3). 12.0.0 is the only
         12.x release; NuGet unifies its Avalonia reference up to the 12.0.4 the rest of the
         project uses. Published 2026-04-07. -->
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Direct pin only to lift a transitive dependency: Microsoft.Data.Sqlite 10.0.10 (the
         latest stable of the 10.x line) still resolves SQLitePCLRaw 2.1.11, whose bundled
         SQLite is affected by CVE-2025-6965 (NU1903, CVSS 7.2). 2.1.12 is the maintenance
         release that moves the native library to SQLite 3.53.3, past the 3.50.2 fix — verified
         by reading the version string out of the shipped libe_sqlite3.so, not from the notes.
         Remove this line once Microsoft.Data.Sqlite resolves 2.1.12 or later on its own. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- Renders PDF pages into bitmaps for the in-app viewer (PDFium + SkiaSharp under the hood).
         Pinned to 5.2.1, NOT the newest 5.x (5.3.0/5.4.0), because those bump their own SkiaSharp
         dependency to 4.150.1 — a major version Avalonia.Skia 12.0.4 doesn't use (it pins
         SkiaSharp 3.119.4, the same line already referenced above). 5.2.1 depends on SkiaSharp
         3.119.2, which NuGet unifies up to the 3.119.4 already in this project instead of forcing
         a cross-major SkiaSharp split. Published 2026-04-06. -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Globbed, not listed: adding an interface language must be a locale file plus a row in
         LanguageCatalog, with no .csproj edit (docs/PLAN-I18N.md §2.2). -->
    <EmbeddedResource Include="Services/Localization/Locales/*.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyPersonalDrive.Tests" />
    <InternalsVisibleTo Include="MyPersonalDrive.UiTests" />
  </ItemGroup>
</Project>
