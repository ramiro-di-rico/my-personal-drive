<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyPersonalDrive.ViewModels"
        xmlns:syncVm="clr-namespace:MyPersonalDrive.ViewModels.Sync"
        xmlns:local="clr-namespace:MyPersonalDrive.ViewModels.Local"
        xmlns:conv="clr-namespace:MyPersonalDrive.Views.Converters"
        xmlns:providers="clr-namespace:MyPersonalDrive.Services.Providers"
        x:Class="MyPersonalDrive.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MyPersonalDrive"
        Width="1280"
        Height="800">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ToggleSettingsCommand}" />
    <KeyBinding Gesture="Cmd+OemComma" Command="{Binding ToggleSettingsCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!--
      Per-row icon-only actions (copy/rename/download/trash on a folder row, preview/sync-now/
      pause/remove on a sync pair) stay invisible until the row is hovered or one of them gets
      keyboard focus. Opacity (not IsVisible) keeps their layout space reserved, so nothing
      shifts when they fade in — and ":pointerover" on the row container already cascades from
      any descendant the pointer is over, so hovering the row's label is enough.
    -->
    <Style Selector=".hoverGroup Button.rowAction">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=".hoverGroup:pointerover Button.rowAction">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector=".hoverGroup Button.rowAction:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      Row background tint: a neutral tint on hover so any row reads as interactive, and the
      accent — reserved for "this is the important one" — on the row actually selected. Order
      matters here: ".selected" is declared after ":pointerover" so it still wins when a selected
      row is also under the pointer.
    -->
    <Style Selector="Grid.hoverGroup">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.hoverGroup:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>
    <Style Selector="Grid.hoverGroup.selected">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>

    <!--
      The listing is hosted in a ListBox for its panel and keyboard focus handling, but the row
      chrome is entirely ours (.hoverGroup / .selected above, driven by the view model's own
      selection). Flatten the ListBoxItem so the theme's padding and selection brush don't fight
      that: without this, a selected row shows two overlapping highlights of different shapes.
    -->
    <Style Selector="ListBox.driveListing">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.driveListing ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.driveListing ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Tile chrome, shared by the icons and gallery modes. -->
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>
    <Style Selector="Border.tile.selected">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Top Header Bar with Telemetry, Quota & Theme Switcher -->
    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource CardBackgroundBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <!-- Brand & Active Storage Provider Context -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource IconCloud}" Width="22" Height="22" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="DRIVE" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Provider Context Switcher ComboBox -->
          <ComboBox ItemsSource="{Binding AvailableProviders}"
                    SelectedItem="{Binding SelectedProvider}"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Padding="10,4"
                    MinWidth="180"
                    ToolTip.Tip="Seleccionar proveedor de almacenamiento">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="providers:ProviderDescriptor">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center" Margin="2,2">
                  <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconCloud}" Width="16" Height="16" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AccountSummary}" VerticalAlignment="Center" FontSize="10" Opacity="0.6" />
                  </StackPanel>
                  <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center">
                    <Ellipse.Styles>
                      <Style Selector="Ellipse.auth">
                        <Setter Property="Fill" Value="#28A745" />
                      </Style>
                      <Style Selector="Ellipse.unauth">
                        <Setter Property="Fill" Value="#6C757D" />
                      </Style>
                    </Ellipse.Styles>
                    <Classes.auth>
                      <Binding Path="IsAuthenticated" />
                    </Classes.auth>
                    <Classes.unauth>
                      <Binding Path="!IsAuthenticated" />
                    </Classes.unauth>
                  </Ellipse>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Center / Right Telemetry, Quota & Theme Switcher -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <!-- Connection Status Telemetry Badge -->
          <Border Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  Padding="8,4"
                  ToolTip.Tip="{Binding ConnectionStatusDescription}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Styles>
                  <Style Selector="Ellipse.online">
                    <Setter Property="Fill" Value="#28A745" />
                  </Style>
                  <Style Selector="Ellipse.syncing">
                    <Setter Property="Fill" Value="#007ACC" />
                  </Style>
                  <Style Selector="Ellipse.ratelimited">
                    <Setter Property="Fill" Value="#FFC107" />
                  </Style>
                  <Style Selector="Ellipse.disconnected">
                    <Setter Property="Fill" Value="#DC3545" />
                  </Style>
                </Ellipse.Styles>
                <Classes.online>
                  <Binding Path="IsOnline" />
                </Classes.online>
                <Classes.syncing>
                  <Binding Path="IsSyncing" />
                </Classes.syncing>
                <Classes.ratelimited>
                  <Binding Path="IsRateLimited" />
                </Classes.ratelimited>
                <Classes.disconnected>
                  <Binding Path="IsDisconnected" />
                </Classes.disconnected>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Storage Quota Gauge -->
          <Border Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  Padding="8,4"
                  ToolTip.Tip="{Binding QuotaDisplay}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconDatabase}" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.7" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding QuotaDisplay}" FontSize="11" FontWeight="Medium" />
                <ProgressBar Value="{Binding QuotaPercent}" Minimum="0" Maximum="100" Height="4" Width="90" CornerRadius="2" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Theme Switcher (System / Light / Dark) -->
          <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Command="{Binding SetThemeDefaultCommand}"
                      Classes.active="{Binding IsSystemTheme}"
                      ToolTip.Tip="Tema del sistema (predeterminado)"
                      Padding="6,4">
                <Path Classes="icon" Data="{StaticResource IconMonitor}" Width="14" Height="14" />
              </Button>
              <Button Command="{Binding SetThemeLightCommand}"
                      Classes.active="{Binding IsLightTheme}"
                      ToolTip.Tip="Tema claro"
                      Padding="6,4">
                <Path Classes="icon" Data="{StaticResource IconSun}" Width="14" Height="14" />
              </Button>
              <Button Command="{Binding SetThemeDarkCommand}"
                      Classes.active="{Binding IsDarkTheme}"
                      ToolTip.Tip="Tema oscuro"
                      Padding="6,4">
                <Path Classes="icon" Data="{StaticResource IconMoon}" Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Global Settings Shortcut Button -->
          <Button Command="{Binding ToggleSettingsCommand}"
                  Classes.active="{Binding IsSettingsView}"
                  ToolTip.Tip="Configuración global (Ctrl+,)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconSettings}" Width="14" Height="14" />
              <TextBlock Text="Configuración" FontSize="12" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="16,12,16,0">
      <StackPanel.Styles>
        <Style Selector="Button.active">
          <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
      </StackPanel.Styles>
      <Button Command="{Binding ShowExplorerCommand}"
              Classes.active="{Binding !IsSettingsView}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{StaticResource IconExplorer}" />
          <TextBlock Text="Explorador" />
        </StackPanel>
      </Button>
      <!-- Opens the viewer on whatever row is selected. A menu entry and not only a per-row action,
           so it's discoverable without hovering a row or opening a context menu; it stays disabled
           until the selection is something the viewer can actually show (TextPreviewPolicy /
           ImagePreviewPolicy). -->
      <Button Command="{Binding ViewSelectedFileCommand}"
              Classes.active="{Binding IsViewerVisible}"
              ToolTip.Tip="Ver el contenido del archivo seleccionado">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{StaticResource IconEye}" />
          <TextBlock Text="Visor" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Explorer view: breadcrumbs, folder browser, status panel and CLI activity log. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding !IsSettingsView}">
      <Grid Grid.Row="0" Margin="16" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <Grid.Styles>
          <Style Selector="Button.viewMode.active">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          </Style>
        </Grid.Styles>
        <Border Grid.Column="0" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
          <ScrollViewer x:Name="BreadcrumbScroll"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding BreadcrumbItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BreadcrumbSegmentViewModel">
                <Button Command="{Binding OpenCommand}"
                        Content="{Binding Label}"
                        ToolTip.Tip="{Binding Label}"
                        IsEnabled="{Binding CanNavigate}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
        </Border>

        <Button Grid.Column="1" ToolTip.Tip="Go back" Command="{Binding BackCommand}">
          <Path Classes="icon" Data="{StaticResource IconArrowLeft}" />
        </Button>
        <Button Grid.Column="2" ToolTip.Tip="Create folder" Command="{Binding CreateFolderCommand}">
          <Path Classes="icon" Data="{StaticResource IconFolderPlus}" />
        </Button>
        <Button Grid.Column="3" ToolTip.Tip="Upload files" Command="{Binding UploadCommand}">
          <Path Classes="icon" Data="{StaticResource IconUpload}" />
        </Button>

        <!-- View mode: list / icons / gallery. Only the presentation changes; the listing and the
             current selection are untouched (docs/PLAN-BROWSER-VIEWS.md V1). -->
        <Button Grid.Column="4"
                Classes="viewMode"
                Classes.active="{Binding IsListView}"
                ToolTip.Tip="Ver como lista"
                Command="{Binding ShowListViewCommand}">
          <Path Classes="icon" Data="{StaticResource IconViewList}" />
        </Button>
        <Button Grid.Column="5"
                Classes="viewMode"
                Classes.active="{Binding IsIconsView}"
                ToolTip.Tip="Ver como iconos"
                Command="{Binding ShowIconsViewCommand}">
          <Path Classes="icon" Data="{StaticResource IconViewGrid}" />
        </Button>
        <Button Grid.Column="6"
                Classes="viewMode"
                Classes.active="{Binding IsGalleryView}"
                ToolTip.Tip="Ver como galería"
                Command="{Binding ShowGalleryViewCommand}">
          <Path Classes="icon" Data="{StaticResource IconViewGallery}" />
        </Button>

        <!-- Persisted (docs/INTERFACE_IMPROVEMENT_PLAN.md Task 3): the state the user leaves it in
             is also next launch's default. The Status sidebar has the equivalent checkbox under
             "User Settings" instead of a header button. -->
        <Button Grid.Column="7"
                Classes="viewMode"
                Classes.active="{Binding IsLocalExplorerPanelVisible}"
                ToolTip.Tip="Mostrar/ocultar el explorador local"
                Command="{Binding ToggleLocalExplorerPanelCommand}">
          <Path Classes="icon" Data="{StaticResource IconPanelRight}" />
        </Button>
      </Grid>

      <Grid x:Name="ExplorerColumnsGrid" Grid.Row="1" ColumnDefinitions="*,Auto,*,Auto">
        <Grid Grid.Column="0" Margin="16,0,16,16" RowDefinitions="Auto,Auto,*">
          <!-- One sort control for all three modes rather than column headers in list mode plus a
               separate control for the tiles: the state is the same either way, and two ways to set
               it means two places to keep in step (docs/PLAN-BROWSER-VIEWS.md V4). Sorting is done
               in memory over the rows already loaded, so it costs no CLI call. -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
            <StackPanel.Styles>
              <Style Selector="Button.sortKey">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
              </Style>
              <Style Selector="Button.sortKey.active">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
              </Style>
            </StackPanel.Styles>
            <TextBlock Text="Ordenar por:" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByName}" Command="{Binding SortByNameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Nombre" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByName}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedBySize}" Command="{Binding SortBySizeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Tamaño" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedBySize}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByModified}" Command="{Binding SortByModifiedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Modificado" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByModified}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByKind}" Command="{Binding SortByKindCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Tipo" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByKind}" FontSize="10" />
              </StackPanel>
            </Button>

            <TextBlock Text="{Binding FilterSummary}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Opacity="0.7"
                       FontSize="12"
                       IsVisible="{Binding FilterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <!-- Filter by type. The chips come from the metrics histogram, so they only ever offer
               kinds the folder actually contains (docs/PLAN-BROWSER-VIEWS.md M6). Filtering is a
               view of what was already loaded - it makes no CLI call, and it does not change the
               metrics panel, which keeps describing the whole folder. -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding KindFilters}" Margin="0,0,0,8">
            <ItemsControl.Styles>
              <Style Selector="Button.kindChip">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,6,6" />
              </Style>
              <Style Selector="Button.kindChip.active">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KindFilterViewModel">
                <Button Classes="kindChip"
                        Classes.active="{Binding IsActive}"
                        Command="{Binding ApplyCommand}"
                        Content="{Binding LabelWithCount}"
                        ToolTip.Tip="Filtrar por este tipo" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Grid.Row="2">
          <!-- Unauthenticated / Expired Session Fallback Card -->
          <Border IsVisible="{Binding !IsAuthenticated}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="8"
                  Padding="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="480">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconKey}" Width="36" Height="36" Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Autenticación Requerida" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" />
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Classes="primary" Content="Iniciar Sesión" Command="{Binding AuthenticateCommand}" Padding="16,8" />
                <Button Content="Configuración" Command="{Binding ToggleSettingsCommand}" Padding="16,8" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- List mode: the original row, one per line, with the per-row actions inline. -->
          <ListBox x:Name="ListModeListing"
                   Classes="driveListing"
                   ItemsSource="{Binding RootItems}"
                   IsVisible="{Binding IsListView}"
                   KeyDown="OnListingKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DriveNodeViewModel">
                <Grid Classes="hoverGroup"
                      Classes.selected="{Binding IsSelected}"
                      ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
                      Margin="0,0,0,6">
                  <Button Grid.Column="0"
                          Command="{Binding RowCommand}"
                          ToolTip.Tip="Select item or open folder"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Focusable="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="icon" Data="{StaticResource IconFolder}" IsVisible="{Binding IsFolder}" />
                      <Path Classes="icon" Data="{StaticResource IconFile}" IsVisible="{Binding IsFile}" />
                      <TextBlock Text="{Binding DisplayName}" />
                    </StackPanel>
                  </Button>

                  <!-- The folder's recursive size, when someone has already scanned it. Files show
                       nothing here: their size is already in the details panel. -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding DeepSizeText}"
                             IsVisible="{Binding HasDeepSize}"
                             VerticalAlignment="Center"
                             Margin="8,0"
                             FontSize="12"
                             Opacity="0.7" />

                  <Button Grid.Column="2"
                          Classes="rowAction"
                          ToolTip.Tip="Ver el contenido"
                          Margin="8,0,0,0"
                          Command="{Binding PreviewCommand}"
                          IsVisible="{Binding CanPreview}">
                    <Path Classes="icon" Data="{StaticResource IconEye}" />
                  </Button>

                  <Button Grid.Column="3"
                          Classes="rowAction"
                          ToolTip.Tip="Create a copy"
                          Margin="8,0,0,0"
                          Command="{Binding CopyCommand}">
                    <Path Classes="icon" Data="{StaticResource IconCopy}" />
                  </Button>

                  <Button Grid.Column="4"
                          Classes="rowAction"
                          ToolTip.Tip="Rename item"
                          Margin="8,0,0,0"
                          Command="{Binding RenameCommand}">
                    <Path Classes="icon" Data="{StaticResource IconPencil}" />
                  </Button>

                  <Button Grid.Column="5"
                          Classes="rowAction"
                          ToolTip.Tip="Download file"
                          Margin="8,0,0,0"
                          Command="{Binding DownloadCommand}"
                          IsVisible="{Binding IsFile}">
                    <Path Classes="icon" Data="{StaticResource IconDownload}" />
                  </Button>

                  <Button Grid.Column="6"
                          Classes="rowAction"
                          ToolTip.Tip="Move to trash"
                          Margin="8,0,0,0"
                          Command="{Binding TrashCommand}"
                          IsVisible="{Binding IsFile}">
                    <Path Classes="icon" Data="{StaticResource IconTrash}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Icons mode: a dense grid. The five row actions don't fit on a 112px tile, so they
               move into a context menu bound to the same commands.

               ItemsRepeater + UniformGridLayout rather than a ListBox over a WrapPanel: WrapPanel
               materializes every child, so a folder with thousands of items would build thousands of
               tiles up front (docs/PLAN-BROWSER-VIEWS.md §3). ItemsRepeater virtualizes, at the cost
               of having no selection or keyboard model of its own - which costs this app nothing,
               because row selection is the view model's (Classes.selected on IsSelected) and
               activation is the tile's own Button. -->
          <ScrollViewer IsVisible="{Binding IsIconsView}" HorizontalScrollBarVisibility="Disabled">
          <ItemsRepeater ItemsSource="{Binding RootItems}">
            <ItemsRepeater.Layout>
              <UniformGridLayout ItemsStretch="Fill" MinItemWidth="112" MinItemHeight="112" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:DriveNodeViewModel">
                <Border Classes="tile" Classes.selected="{Binding IsSelected}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Abrir / seleccionar" Command="{Binding RowCommand}" />
                      <MenuItem Header="Ver el contenido" Command="{Binding PreviewCommand}" IsVisible="{Binding CanPreview}" />
                      <MenuItem Header="Crear una copia" Command="{Binding CopyCommand}" />
                      <MenuItem Header="Renombrar" Command="{Binding RenameCommand}" />
                      <MenuItem Header="Descargar" Command="{Binding DownloadCommand}" IsVisible="{Binding IsFile}" />
                      <MenuItem Header="Mover a la papelera" Command="{Binding TrashCommand}" IsVisible="{Binding IsFile}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Button Command="{Binding RowCommand}"
                          ToolTip.Tip="{Binding DisplayName}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                      <Path Classes="icon"
                            Width="32"
                            Height="32"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            Data="{Binding FileKind, Converter={x:Static conv:FileKindIconConverter.Instance}}" />
                      <TextBlock Text="{Binding DisplayName}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis"
                                 FontSize="12" />
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          </ScrollViewer>

          <!-- Gallery mode: large tiles with a metadata line. Deliberately NOT image previews -
               the CLI exposes no thumbnails, and generating them would mean downloading every file
               (docs/PLAN-BROWSER-VIEWS.md §7). -->
          <ScrollViewer IsVisible="{Binding IsGalleryView}" HorizontalScrollBarVisibility="Disabled">
          <ItemsRepeater ItemsSource="{Binding RootItems}">
            <ItemsRepeater.Layout>
              <UniformGridLayout ItemsStretch="Fill" MinItemWidth="176" MinItemHeight="200" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:DriveNodeViewModel">
                <Border Classes="tile" Classes.selected="{Binding IsSelected}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Abrir / seleccionar" Command="{Binding RowCommand}" />
                      <MenuItem Header="Ver el contenido" Command="{Binding PreviewCommand}" IsVisible="{Binding CanPreview}" />
                      <MenuItem Header="Crear una copia" Command="{Binding CopyCommand}" />
                      <MenuItem Header="Renombrar" Command="{Binding RenameCommand}" />
                      <MenuItem Header="Descargar" Command="{Binding DownloadCommand}" IsVisible="{Binding IsFile}" />
                      <MenuItem Header="Mover a la papelera" Command="{Binding TrashCommand}" IsVisible="{Binding IsFile}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Button Command="{Binding RowCommand}"
                          ToolTip.Tip="{Binding DisplayName}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                      <Border Background="{DynamicResource CardBackgroundBrush}"
                              CornerRadius="6"
                              Height="96"
                              Padding="12">
                        <Path Classes="icon"
                              Width="64"
                              Height="64"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{Binding FileKind, Converter={x:Static conv:FileKindIconConverter.Instance}}" />
                      </Border>
                      <TextBlock Text="{Binding DisplayName}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SizeText}"
                                 TextAlignment="Center"
                                 Opacity="0.7"
                                 FontSize="12"
                                 IsVisible="{Binding SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding DeepSizeText}"
                                 TextAlignment="Center"
                                 Opacity="0.7"
                                 FontSize="12"
                                 IsVisible="{Binding HasDeepSize}" />
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          </ScrollViewer>
          </Grid>
        </Grid>

        <!-- Adjustable split between the cloud and local panes (docs/INTERFACE_IMPROVEMENT_PLAN.md
             Task 3). Drag resizes both star-sized columns automatically; double-click resets them
             to 50/50 via ExplorerSplitter_DoubleTapped (Avalonia's GridSplitter has no built-in
             reset gesture). -->
        <GridSplitter x:Name="ExplorerSplitter"
                      Grid.Column="1"
                      Width="6"
                      Margin="4,16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource CardBackgroundBrush}"
                      Cursor="SizeWestEast"
                      ResizeDirection="Columns"
                      DoubleTapped="ExplorerSplitter_DoubleTapped"
                      IsVisible="{Binding IsLocalExplorerPanelVisible}"
                      ToolTip.Tip="Drag to resize · double-click to reset" />

        <!-- Local pane: read-only browsing only (navigate, breadcrumb, home, hidden-files toggle,
             free space). File operations and drag-and-drop transfer are separate plan tasks.
             Hidden/shown via ToggleLocalExplorerPanelCommand; ExplorerColumnsGrid's own Column[2]
             width is collapsed to 0 alongside this in MainWindow.axaml.cs, since a star-sized
             column doesn't shrink on its own just because its content is invisible. IsVisible sits
             on this outer Grid (still bound to the window's own DataContext) rather than the inner
             one, which switches DataContext to LocalExplorer and so can't see this VM's property. -->
        <Grid Grid.Column="2" Margin="0,0,16,16" IsVisible="{Binding IsLocalExplorerPanelVisible}">
        <Grid RowDefinitions="Auto,*" DataContext="{Binding LocalExplorer}">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <Grid.Styles>
              <Style Selector="Button.viewMode.active">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Style>
            </Grid.Styles>
            <Border Grid.Column="0" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding BreadcrumbItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreadcrumbSegmentViewModel">
                      <Button Command="{Binding OpenCommand}"
                              Content="{Binding Label}"
                              ToolTip.Tip="{Binding Label}"
                              IsEnabled="{Binding CanNavigate}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <Button Grid.Column="1" ToolTip.Tip="Go to home folder" Command="{Binding GoHomeCommand}">
              <Path Classes="icon" Data="{StaticResource IconHome}" />
            </Button>
            <Button Grid.Column="2"
                    Classes="viewMode"
                    Classes.active="{Binding ShowHiddenFiles}"
                    ToolTip.Tip="Toggle hidden files"
                    Command="{Binding ToggleHiddenFilesCommand}">
              <Path Classes="icon" Data="{StaticResource IconEyeOff}" />
            </Button>
            <Button Grid.Column="3" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}">
              <Path Classes="icon" Data="{StaticResource IconRefresh}" />
            </Button>
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       FontSize="12"
                       Text="{Binding FreeSpaceText, StringFormat='{}{0} free'}" />
          </Grid>

          <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ListBox Grid.Row="1" Classes="driveListing" ItemsSource="{Binding Items}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:LocalNodeViewModel">
                  <Button Classes="hoverGroup" Command="{Binding RowCommand}" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                      <Path Grid.Column="0"
                            Classes="icon"
                            Width="18"
                            Height="18"
                            Data="{Binding FileKind, Converter={x:Static conv:FileKindIconConverter.Instance}}" />
                      <TextBlock Grid.Column="1"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding DisplayName}" />
                      <TextBlock Grid.Column="2"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Opacity="0.8"
                                 Text="{Binding SizeText}" />
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Opacity="0.7"
                                 Text="{Binding ModifiedText}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
        </Grid>

        <Border Grid.Column="3" Margin="0,0,16,16" Padding="16" Width="340" Background="{DynamicResource CardBackgroundBrush}" IsVisible="{Binding IsStatusPanelVisible}">
          <!-- Scrollable since the metrics section landed: status + selection + metrics is taller
               than the panel on a short window, and a clipped histogram is worse than a scrollbar. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock FontSize="18" Text="Status" />
            <Border Name="StatusBorder"
                    Padding="8"
                    CornerRadius="4"
                    Classes.warning="{Binding IsWarning}"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Name="WarningIcon"
                      Classes="icon"
                      Data="{StaticResource IconWarning}"
                      Stroke="#856404"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsWarning}" />
                <TextBlock Name="StatusText"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Border.Styles>
                <Style Selector="Border#StatusBorder">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Border#StatusBorder.warning">
                  <Setter Property="Background" Value="#FFF3CD" />
                </Style>
                <Style Selector="Border#StatusBorder.warning TextBlock#StatusText">
                  <Setter Property="Foreground" Value="#856404" />
                </Style>
              </Border.Styles>
            </Border>

            <TextBlock Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="Select a file or folder to see its details."
                       IsVisible="{Binding !HasSelection}" />

            <StackPanel Spacing="10" IsVisible="{Binding HasSelection}">
              <TextBlock FontWeight="Bold" Text="Selected item" />
              <TextBlock Text="{Binding SelectedName}" />
              <TextBlock FontWeight="Bold" Text="Type" />
              <TextBlock Text="{Binding SelectedKind}" />
              <TextBlock FontWeight="Bold" Text="Path" />
              <TextBlock TextWrapping="Wrap" Text="{Binding SelectedPath}" />
              <TextBlock FontWeight="Bold" Text="Size" />
              <TextBlock Text="{Binding SelectedSize}" />
              <TextBlock FontWeight="Bold" Text="Modified" />
              <TextBlock TextWrapping="Wrap" Text="{Binding SelectedModified}" />
              <TextBlock FontWeight="Bold" Text="Owner" />
              <TextBlock TextWrapping="Wrap" Text="{Binding SelectedOwner}" />
              <TextBlock FontWeight="Bold" Text="Shared" />
              <TextBlock Text="{Binding SelectedShared}" />
            </StackPanel>

            <!-- Métricas: computed from the listing already on screen, so it costs nothing.
                 Shallow by design - a recursive total needs a multi-minute scan per folder on this
                 CLI (docs/PLAN-BROWSER-VIEWS.md M2/M3), which is why ScopeNote spells out what the
                 total leaves out instead of letting it read as recursive. -->
            <Border Height="1" Background="{DynamicResource CardBackgroundBrush}" Margin="0,4" />
            <TextBlock FontSize="16" FontWeight="Bold" Text="Métricas de la carpeta" />
            <TextBlock Text="{Binding Metrics.Headline}" />

            <StackPanel Spacing="10" IsVisible="{Binding Metrics.HasItems}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="Bold" Text="{Binding Metrics.TotalSizeText}" FontSize="18" />
                <TextBlock Text="{Binding Metrics.TotalSizeCaption}" TextWrapping="Wrap" VerticalAlignment="Bottom" Opacity="0.7" FontSize="12" />
              </StackPanel>
              <TextBlock Text="{Binding Metrics.DepthNote}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Opacity="0.8"
                         IsVisible="{Binding Metrics.DepthNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding Metrics.ScopeNote}"
                         TextWrapping="Wrap"
                         Opacity="0.7"
                         FontSize="12"
                         IsVisible="{Binding Metrics.ScopeNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- The recursive scan. Explicitly user-initiated and labelled with its cost: on this
                   CLI it is one ~3.5s process per subfolder (docs/PLAN-BROWSER-VIEWS.md M3), so it
                   must never fire on navigation. -->
              <Button Command="{Binding ScanFolderDeeplyCommand}"
                      IsVisible="{Binding !Metrics.IsScanning}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left">
                <StackPanel Spacing="2">
                  <TextBlock Text="Calcular tamaño total (recursivo)" />
                  <TextBlock Text="Analiza todas las subcarpetas; puede tardar varios minutos."
                             TextWrapping="Wrap"
                             FontSize="11"
                             Opacity="0.7" />
                </StackPanel>
              </Button>

              <StackPanel Spacing="6" IsVisible="{Binding Metrics.IsScanning}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{Binding Metrics.ProgressText}" FontSize="12" />
                <Button Command="{Binding CancelDeepScanCommand}" Content="Cancelar análisis" />
              </StackPanel>

              <!-- Bar chart made of Borders: no charting dependency, and the widths come from the
                   view model (see FolderMetricBucketViewModel.BarMaxWidth, which tracks the 260px
                   of content width this 340px panel leaves after its padding). -->
              <ItemsControl ItemsSource="{Binding Metrics.Buckets}" IsVisible="{Binding Metrics.HasBuckets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderMetricBucketViewModel">
                    <StackPanel Spacing="2" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Opacity="0.8" />
                      </Grid>
                      <Border Height="6"
                              CornerRadius="3"
                              HorizontalAlignment="Left"
                              Width="{Binding BarWidth}"
                              Background="{DynamicResource AccentBrush}" />
                      <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock FontWeight="Bold" Text="Más grandes" IsVisible="{Binding Metrics.HasLargestItems}" />
              <ItemsControl ItemsSource="{Binding Metrics.LargestItems}" IsVisible="{Binding Metrics.HasLargestItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LargestItemViewModel">
                    <Button Command="{Binding SelectCommand}"
                            ToolTip.Tip="{Binding Name}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,2">
                      <Grid ColumnDefinitions="*,Auto" Width="256">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Opacity="0.8" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Más reciente:" FontSize="12" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{Binding Metrics.NewestText}" FontSize="12" />
                <TextBlock Grid.Row="1" Text="Más antiguo:" FontSize="12" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Metrics.OldestText}" FontSize="12" />
              </Grid>
            </StackPanel>

            <TextBlock FontWeight="Bold" Text="Current folder" />
            <TextBlock TextWrapping="Wrap" Text="{Binding CurrentPath}" />
            <TextBlock FontWeight="Bold" Text="Root" />
            <TextBlock Text="{Binding RootPath}" />
          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Grid.Row="2" Margin="16,0,16,16" Padding="12" Background="{DynamicResource ConsoleBackgroundBrush}" CornerRadius="6">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}">
            <ProgressBar Width="120" IsIndeterminate="True" />
            <TextBlock VerticalAlignment="Center" Text="Loading..." />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock FontSize="16" FontWeight="Bold" Text="CLI activity" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ActiveCommand}" />
            <Button Grid.Column="2"
                    Command="{Binding ToggleCommandConsoleCommand}"
                    ToolTip.Tip="{Binding CommandConsoleToggleLabel}">
              <TextBlock Text="{Binding CommandConsoleToggleGlyph}" />
            </Button>
            <Button Grid.Column="3"
                    Command="{Binding DownloadActivityCommand}"
                    ToolTip.Tip="Download activity log">
              <Path Classes="icon" Data="{StaticResource IconSave}" />
            </Button>
            <Button Grid.Column="4"
                    Command="{Binding ClearActivityCommand}"
                    ToolTip.Tip="Clear activity log">
              <Path Classes="icon" Data="{StaticResource IconClear}" />
            </Button>
          </Grid>
          <Border MaxHeight="{Binding CommandConsoleMaxHeight}"
                  Opacity="{Binding CommandConsoleOpacity}"
                  IsHitTestVisible="{Binding CommandConsoleHitTestVisible}"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="MaxHeight" Duration="0:0:0.35" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
              </Transitions>
            </Border.Transitions>
            <!-- NoWrap, with horizontal scrolling, is a deliberate performance choice as much as a
                 stylistic one. Wrapping forced Avalonia to shape and wrap the console's entire text
                 on every update: a captured stack during a 30-second UI hang was TextBlock.Measure
                 -> TextLayout.CreateTextLines -> HarfBuzzTextShaper.ShapeText. Long lines are also
                 easier to read unwrapped in a console, and CommandLogBuffer now caps their length. -->
            <ScrollViewer Height="140" HorizontalScrollBarVisibility="Auto">
              <TextBlock TextWrapping="NoWrap" Text="{Binding CommandLogText}" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!--
        The text viewer, as a panel over the listing rather than a separate window: it can't get
        lost behind the main window, and closing it is a view-model flag instead of window plumbing
        in code-behind. Covers row 1 only, so the breadcrumbs above and the CLI activity log below
        stay visible while a file is open.
      -->
      <Border Grid.Row="1"
              Margin="16,0,16,16"
              Padding="16"
              CornerRadius="6"
              Background="{DynamicResource PanelBackgroundBrush}"
              IsVisible="{Binding IsViewerVisible}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding ViewerTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="12" Opacity="0.7" Text="{Binding ViewerPath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{Binding CloseViewerCommand}"
                    ToolTip.Tip="Cerrar el visor">
              <Path Classes="icon" Data="{StaticResource IconClear}" />
            </Button>
          </Grid>

          <TextBlock Grid.Row="1"
                     FontSize="12"
                     Opacity="0.8"
                     TextWrapping="Wrap"
                     Text="{Binding ViewerNote}"
                     IsVisible="{Binding ViewerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsViewerLoading}">
            <ProgressBar Width="120" IsIndeterminate="True" />
            <TextBlock VerticalAlignment="Center" Text="Descargando el archivo para verlo…" />
          </StackPanel>

          <!-- NoWrap with horizontal scrolling, for the same reason as the CLI console above:
               wrapping re-shapes the whole text on every change, and a preview can be a megabyte.
               SelectableTextBlock rather than a read-only TextBox so the text can be copied without
               dragging a full editor into the view. -->
          <Border Grid.Row="3"
                  Padding="12"
                  CornerRadius="4"
                  Background="{DynamicResource ConsoleBackgroundBrush}"
                  IsVisible="{Binding HasViewerText}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock FontFamily="monospace"
                                   FontSize="13"
                                   TextWrapping="NoWrap"
                                   Text="{Binding ViewerText}" />
            </ScrollViewer>
          </Border>

          <!-- The image counterpart: Stretch="Uniform" so a huge photo fits the panel instead of
               overflowing it, and the ScrollViewer stays available for the rare image bigger than
               the panel even at that scale (a very tall panorama, say). -->
          <Border Grid.Row="3"
                  Padding="12"
                  CornerRadius="4"
                  Background="{DynamicResource ConsoleBackgroundBrush}"
                  IsVisible="{Binding HasViewerImage}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Image Source="{Binding ViewerImageBytes, Converter={x:Static conv:BytesToBitmapConverter.Instance}}"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Settings view: CLI connection, preferences and local directory sync, in one place instead of stacked dialogs. -->
    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsSettingsView}">
      <StackPanel Margin="16" Spacing="24">
        <!-- General Preferences: Theme, Bandwidth throttle, Default sync folder -->
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="Bold" Text="Preferencias Generales" />
          <Border Padding="16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
            <StackPanel Spacing="14">
              <!-- Theme Selection -->
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Tema visual del espacio de trabajo:" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes.primary="{Binding IsSystemTheme}" Content="Predeterminado del sistema" Command="{Binding SetThemeDefaultCommand}" />
                  <Button Classes.primary="{Binding IsLightTheme}" Content="Claro" Command="{Binding SetThemeLightCommand}" />
                  <Button Classes.primary="{Binding IsDarkTheme}" Content="Oscuro" Command="{Binding SetThemeDarkCommand}" />
                </StackPanel>
              </StackPanel>

              <!-- Default Sync Folder -->
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Carpeta local de sincronización predeterminada:" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Width="420"
                           PlaceholderText="Carpeta local predeterminada para descargas y sincronización"
                           Text="{Binding DefaultSyncFolder, Mode=TwoWay}" />
                  <Button ToolTip.Tip="Seleccionar carpeta de sincronización predeterminada" Click="BrowseDefaultSyncFolder">
                    <Path Classes="icon" Data="{StaticResource IconFolder}" />
                  </Button>
                </StackPanel>
              </StackPanel>

              <!-- Bandwidth Throttling -->
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Límite de ancho de banda de red (KB/s, 0 = sin límite):" />
                <NumericUpDown Width="200"
                               HorizontalAlignment="Left"
                               Minimum="0"
                               Maximum="1000000"
                               Increment="100"
                               FormatString="{}{0:N0} KB/s"
                               Value="{Binding BandwidthLimitKbps, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- User Settings: app-level UI preferences that aren't tied to any provider or CLI. -->
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="Bold" Text="User Settings" />
          <Border Padding="16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
            <CheckBox Content="Status Visible" IsChecked="{Binding IsStatusPanelVisible, Mode=TwoWay}" />
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="Bold" Text="Conexión" />

          <!-- Provider picker: which backend is active. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes.primary="{Binding IsProtonActive}" Content="Proton Drive" Command="{Binding SwitchToProtonCommand}" />
            <Button Classes.primary="{Binding IsOneDriveActive}" Content="OneDrive" Command="{Binding SwitchToOneDriveCommand}" />
            <Button Classes.primary="{Binding IsGoogleDriveActive}" Content="Google Drive" Command="{Binding SwitchToGoogleDriveCommand}" />
            <Button Classes.primary="{Binding IsNextcloudActive}" Content="Nextcloud" Command="{Binding SwitchToNextcloudCommand}" />
            <Button Classes.primary="{Binding IsS3Active}" Content="Custom S3" Command="{Binding SwitchToS3Command}" />
          </StackPanel>

          <!-- Proton's card: CLI path, auth, version, self-update. -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsProtonActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="Ruta al ejecutable de proton-drive:" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="420"
                         PlaceholderText="Path to proton-drive executable"
                         Text="{Binding CliPath, Mode=TwoWay}" />
                <Button ToolTip.Tip="Select proton-drive executable" Click="BrowseCliPath">
                  <Path Classes="icon" Data="{StaticResource IconFolder}" />
                </Button>
                <Button Classes="primary" ToolTip.Tip="Authenticate to Proton Drive" Command="{Binding AuthenticateCommand}">
                  <Path Classes="icon" Data="{StaticResource IconKey}" />
                </Button>
                <Button ToolTip.Tip="Logout from Proton Drive" Command="{Binding LogoutCommand}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="Refresh folder content" Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>

              <!-- Version/self-update rows: gated on HasDiagnostics rather than a Proton-specific
                   flag, so a third provider with no external binary needs no XAML change here
                   (docs/PLAN-CLOUD-PROVIDERS.md §5 item 2) — for now that's every non-Proton
                   provider, but the binding itself doesn't know that. -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDiagnostics}">
                <TextBlock VerticalAlignment="Center" Text="Versión del CLI:" />
                <TextBlock VerticalAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Text="{Binding CliVersion}" />
                <Button ToolTip.Tip="Re-read the CLI version" Command="{Binding CheckCliVersionCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDiagnostics}">
                <TextBlock VerticalAlignment="Center" Text="Actualización:" />
                <TextBlock VerticalAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Text="{Binding CliUpdateStatus}" />
                <Button ToolTip.Tip="Check Proton's published releases"
                        Command="{Binding CheckForCliUpdateCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
                <Button Classes="primary"
                        Content="Actualizar el CLI"
                        IsVisible="{Binding IsCliUpdateAvailable}"
                        ToolTip.Tip="Download, verify the published SHA-512, and replace the executable"
                        Command="{Binding InstallCliUpdateCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- OneDrive's card: client id, sign-in/out, account label. No CLI path, no version row
               — there is no external binary to point at or version (Diagnostics is null). -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsOneDriveActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="Azure app registration client ID:" />
              <TextBlock Opacity="0.6"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Text="Needs its own Azure app registration with the &quot;Mobile and desktop applications&quot; platform and a http://localhost redirect URI — see README.md § OneDrive setup." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="420"
                         PlaceholderText="Public client application (client) ID"
                         Text="{Binding OneDriveClientId, Mode=TwoWay}" />
                <Button Classes="primary" ToolTip.Tip="Sign in to OneDrive" Command="{Binding AuthenticateCommand}">
                  <Path Classes="icon" Data="{StaticResource IconKey}" />
                </Button>
                <Button ToolTip.Tip="Sign out of OneDrive" Command="{Binding LogoutCommand}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="Refresh folder content" Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="Cuenta:" />
                <TextBlock VerticalAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Text="{Binding OneDriveAccountLabel}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Google Drive's card -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsGoogleDriveActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="Google Workspace &amp; Drive Account Connection" FontWeight="SemiBold" />
              <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                         Text="Connect with Google OAuth2 credentials or API tokens for seamless synchronization." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}" Content="Iniciar Sesión en Google Drive" Command="{Binding AuthenticateCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="Conectar Google Drive" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="Cerrar sesión" Command="{Binding LogoutCommand}" IsVisible="{Binding IsAuthenticated}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="Actualizar contenido" Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Nextcloud's card -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsNextcloudActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="Nextcloud Server Connection (WebDAV)" FontWeight="SemiBold" />
              <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                         Text="Self-hosted Nextcloud instance connectivity and user credentials." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}" Content="Conectar Nextcloud" Command="{Binding AuthenticateCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="Conectar Nextcloud" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="Cerrar sesión" Command="{Binding LogoutCommand}" IsVisible="{Binding IsAuthenticated}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="Actualizar contenido" Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Custom S3 Storage card -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsS3Active}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="Custom S3 / MinIO Object Storage" FontWeight="SemiBold" />
              <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                         Text="Amazon S3, Cloudflare R2, Wasabi, or MinIO bucket endpoint and access keys." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}" Content="Conectar Bucket S3" Command="{Binding AuthenticateCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="Conectar S3" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="Cerrar sesión" Command="{Binding LogoutCommand}" IsVisible="{Binding IsAuthenticated}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="Actualizar contenido" Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10" DataContext="{Binding SyncPanel}">
          <TextBlock FontSize="18" FontWeight="Bold" Text="Sincronización de carpetas" />
          <Border Padding="16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
            <StackPanel Spacing="12">
              <TextBlock Opacity="0.8"
                         TextWrapping="Wrap"
                         Text="Keeps a Proton Drive folder and a local folder in step — download only, upload only, or two-way. It runs on its own: local edits are picked up within seconds, and Proton Drive is re-checked periodically, less often for pairs that take longer to scan. &quot;Sync now&quot; is only for skipping the wait." />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding AddPairCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add pair" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                    <TextBlock Text="Refresh" />
                  </StackPanel>
                </Button>
                <!-- One toggle per active account (P7 Phase A) — pausing OneDrive's automatic
                     sync must not touch Proton's, and vice versa, so this replaces a single
                     shared on/off button rather than sitting alongside it. -->
                <ItemsControl ItemsSource="{Binding AccountSyncToggles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="syncVm:AccountSyncToggleViewModel">
                      <Button Content="{Binding Label}"
                              Command="{Binding ToggleCommand}"
                              ToolTip.Tip="Watch local folders and poll this account automatically" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Filter by account (docs/PLAN-CLOUD-PROVIDERS.md P9) — same chip idiom as the
                   browser's own "filter by type" row. Hidden with a single account, where every
                   pair obviously belongs to it already. -->
              <ItemsControl ItemsSource="{Binding ProviderFilters}"
                            IsVisible="{Binding HasProviderFilters}"
                            Margin="0,8,0,0">
                <ItemsControl.Styles>
                  <Style Selector="Button.providerChip">
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Margin" Value="0,0,6,6" />
                  </Style>
                  <Style Selector="Button.providerChip.active">
                    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="syncVm:ProviderFilterViewModel">
                    <Button Classes="providerChip"
                            Classes.active="{Binding IsActive}"
                            Command="{Binding ApplyCommand}"
                            Content="{Binding LabelWithCount}"
                            ToolTip.Tip="Filtrar por esta cuenta" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding VisiblePairs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="syncVm:SyncPairViewModel">
                    <Border Classes="hoverGroup" Padding="12" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                          <TextBlock FontSize="11"
                                     Opacity="0.6"
                                     FontWeight="Bold"
                                     Text="{Binding AccountLabel}"
                                     IsVisible="{Binding HasAccountLabel}" />
                          <TextBlock FontWeight="Bold" Text="{Binding RemotePath}" />
                          <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding LocalPath}" />
                          <TextBlock Opacity="0.6" Text="{Binding DirectionText}" />
                          <TextBlock Text="{Binding StatusText}" />
                          <Button Content="{Binding ConflictText}"
                                  IsVisible="{Binding HasConflicts}"
                                  Command="{Binding ResolveConflictsCommand}"
                                  HorizontalAlignment="Left"
                                  Foreground="#F5C451"
                                  ToolTip.Tip="Decide what to do with each conflicting file" />
                          <Button Content="↻ Retry failed actions"
                                  IsVisible="{Binding HasFailures}"
                                  Command="{Binding RetryFailedCommand}"
                                  HorizontalAlignment="Left"
                                  ToolTip.Tip="Queue the actions that gave up, to run on the next sync" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                          <Button Classes="rowAction" ToolTip.Tip="Preview changes before syncing" Command="{Binding PreviewCommand}">
                            <Path Classes="icon" Data="{StaticResource IconEye}" />
                          </Button>
                          <Button Classes="rowAction" ToolTip.Tip="Edit direction / conflict policy" Command="{Binding EditCommand}">
                            <Path Classes="icon" Data="{StaticResource IconPencil}" />
                          </Button>
                          <Button Classes="rowAction" ToolTip.Tip="Sync now" Command="{Binding SyncNowCommand}">
                            <Path Classes="icon" Data="{StaticResource IconPlay}" />
                          </Button>
                          <Button Classes="rowAction" ToolTip.Tip="{Binding PauseTooltip}" Command="{Binding TogglePauseCommand}">
                            <Panel>
                              <Path Classes="icon" Data="{StaticResource IconPlay}" IsVisible="{Binding IsPaused}" />
                              <Path Classes="icon" Data="{StaticResource IconPause}" IsVisible="{Binding !IsPaused}" />
                            </Panel>
                          </Button>
                          <Button Classes="rowAction" ToolTip.Tip="Remove this pair" Command="{Binding RemoveCommand}">
                            <Path Classes="icon" Data="{StaticResource IconTrash}" />
                          </Button>
                        </StackPanel>

                        <ProgressBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                     Margin="0,8,0,0"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Padding="10"
                      Background="{DynamicResource ConsoleBackgroundBrush}"
                      CornerRadius="6"
                      IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
