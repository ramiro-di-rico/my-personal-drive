<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyPersonalDrive.ViewModels"
        xmlns:syncVm="clr-namespace:MyPersonalDrive.ViewModels.Sync"
        xmlns:local="clr-namespace:MyPersonalDrive.ViewModels.Local"
        xmlns:conv="clr-namespace:MyPersonalDrive.Views.Converters"
        xmlns:providers="clr-namespace:MyPersonalDrive.Services.Providers"
        xmlns:loc="using:MyPersonalDrive.Services.Localization"
        xmlns:views="clr-namespace:MyPersonalDrive.Views"
        x:Class="MyPersonalDrive.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MyPersonalDrive"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ToggleSettingsCommand}" />
    <KeyBinding Gesture="Cmd+OemComma" Command="{Binding ToggleSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding Console.ToggleCommandConsoleCommand}" />
    <KeyBinding Gesture="Cmd+OemTilde" Command="{Binding Console.ToggleCommandConsoleCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <StyleInclude Source="avares://MyPersonalDrive/Views/Styles/ExplorerStyles.axaml" />
  </Window.Styles>
  <Grid>
  <views:CompactStrip IsVisible="{Binding IsCompactMode}" />

  <Grid RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding !IsCompactMode}">
    <views:HeaderBar Grid.Row="0" />

    <views:ViewTabs Grid.Row="1" />

    <views:AlertStrip Grid.Row="2" />

    <!-- Explorer view: breadcrumbs, folder browser, status panel and CLI activity log. -->
    <Grid Grid.Row="3" RowDefinitions="*,Auto" IsVisible="{Binding IsExplorerView}">
      <Grid x:Name="ExplorerColumnsGrid" Grid.Row="0" ColumnDefinitions="*,Auto,*,Auto">
        <Grid Grid.Column="0" Margin="16,0,16,16" RowDefinitions="Auto,Auto,Auto,Auto,*">
          <views:CloudToolbar Grid.Row="0" />

          <!-- One sort control for all three modes rather than column headers in list mode plus a
               separate control for the tiles: the state is the same either way, and two ways to set
               it means two places to keep in step (docs/PLAN-BROWSER-VIEWS.md V4). Sorting is done
               in memory over the rows already loaded, so it costs no CLI call. -->
          <!-- WrapPanel, not StackPanel: this row carries a search box, a clear button, a result
               count, a label, four sort buttons and a filter summary, and at a narrow window a
               horizontal StackPanel pushes the tail of that off the pane instead of reflowing it
               (docs/PLAN-UX-ROUND-3.md X7). The kind chips below already wrap. -->
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <WrapPanel.Styles>
              <!-- A WrapPanel has no Spacing, so the 4px the StackPanel used to add between
                   children comes from the children now. -->
              <Style Selector="Button.sortKey">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,4,4" />
              </Style>
              <Style Selector="WrapPanel > TextBox">
                <Setter Property="Margin" Value="0,0,4,4" />
              </Style>
              <Style Selector="Button.sortKey.active">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
              </Style>
            </WrapPanel.Styles>
            <!-- Quick filter over the folder's names (docs/INTERFACE_IMPROVEMENT_PLAN.md §2.1's
                 "Global Quick Search") — narrows what's already loaded, no CLI call, combines with
                 the kind chips below rather than replacing them. -->
            <!-- U9 (docs/PLAN-UX-ROUND-2.md §9): the box used to hide rows without saying how many
                 it hid, and the only way out was selecting the text and deleting it. -->
            <TextBox x:Name="CloudSearchBox"
                     Width="200"
                     PlaceholderText="{Binding Loc[explorer.search.placeholder]}"
                     AutomationProperties.Name="{Binding Loc[explorer.search.placeholder]}"
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <Button Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding HasSearchText}"
                    Padding="6,2"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Loc[explorer.search.clear.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[explorer.search.clear.tooltip]}">
              <Path Classes="icon" Data="{StaticResource IconClear}" Width="12" Height="12" />
            </Button>
            <TextBlock Text="{Binding SearchResultText}"
                       IsVisible="{Binding HasSearchText}"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       FontSize="12"
                       Margin="6,0,8,0" />
            <TextBlock Text="{Binding Loc[explorer.sort.label]}" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByName}" Command="{Binding SortByNameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.name]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByName}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedBySize}" Command="{Binding SortBySizeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.size]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedBySize}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByModified}" Command="{Binding SortByModifiedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.modified]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByModified}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByKind}" Command="{Binding SortByKindCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.type]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByKind}" FontSize="10" />
              </StackPanel>
            </Button>

            <TextBlock Text="{Binding FilterSummary}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Opacity="0.7"
                       FontSize="12"
                       IsVisible="{Binding FilterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </WrapPanel>

          <!-- Batch action bar (docs/INTERFACE_IMPROVEMENT_PLAN.md §2.2) — only worth showing once
               Ctrl/Shift+Click or Ctrl+A has actually marked more than one row; a single selection
               already has its own row-level actions (inline buttons, context menu). -->
          <Border Grid.Row="2"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  CornerRadius="6"
                  Background="{DynamicResource AccentMutedBrush}"
                  IsVisible="{Binding HasMultipleSelected}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding SelectionSummaryText}" />
              <Button Content="{Binding Loc[explorer.download.selected]}" Command="{Binding DownloadSelectedCommand}" />
              <!-- Only shown once the selection actually holds two or more PDFs: an always-visible
                   disabled button in a bar that only appears on multi-select is noise. -->
              <Button x:Name="CloudMergeButton"
                      Content="{Binding Loc[pdfmerge.action]}"
                      Command="{Binding MergeSelectedCommand}"
                      IsVisible="{Binding CanMergeSelected}" />
              <Button Content="{Binding Loc[explorer.move.selected]}" Command="{Binding MoveSelectedCommand}" />
              <Button Content="{Binding Loc[menu.trash]}" Command="{Binding TrashSelectedCommand}" />
            </StackPanel>
          </Border>

          <views:KindFilterBar Grid.Row="3" />

          <views:CloudListings Grid.Row="4" x:Name="CloudListingsView" />
        </Grid>

        <!-- Adjustable split between the cloud and local panes (docs/INTERFACE_IMPROVEMENT_PLAN.md
             Task 3). Drag resizes both star-sized columns automatically; double-click resets them
             to 50/50 via ExplorerSplitter_DoubleTapped (Avalonia's GridSplitter has no built-in
             reset gesture). -->
        <GridSplitter x:Name="ExplorerSplitter"
                      Grid.Column="1"
                      Width="6"
                      Margin="4,16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource CardBackgroundBrush}"
                      Cursor="SizeWestEast"
                      ResizeDirection="Columns"
                      DoubleTapped="ExplorerSplitter_DoubleTapped"
                      IsVisible="{Binding IsLocalExplorerPanelVisible}"
                      ToolTip.Tip="{Binding Loc[explorer.splitter.tooltip]}" />

        <views:LocalPane Grid.Column="2" IsVisible="{Binding IsLocalExplorerPanelVisible}" x:Name="LocalPaneView" />

        <views:StatusPanel Grid.Column="3" IsVisible="{Binding IsStatusPanelVisible}" />
      </Grid>

      <views:ActivityConsolePanel Grid.Row="1" />

      <views:FilePreviewPanel Grid.Row="0" IsVisible="{Binding Preview.IsViewerVisible}" />
    </Grid>

    <views:SettingsView Grid.Row="3" IsVisible="{Binding IsSettingsView}" />

    <!-- Sync, as a sibling of the explorer and the settings scroll rather than a section buried
         inside the latter (docs/PLAN-UX-ROUND-2.md §5). The wrapper keeps the window's own
         DataContext so IsSyncView resolves against MainWindowViewModel, while the view itself
         gets the SyncPanelViewModel it is typed against. -->
    <ContentControl Grid.Row="3" IsVisible="{Binding IsSyncView}">
      <views:SyncPanelView DataContext="{Binding SyncPanel}" />
    </ContentControl>
  </Grid>
  </Grid>
</Window>
