<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyPersonalDrive.ViewModels"
        xmlns:syncVm="clr-namespace:MyPersonalDrive.ViewModels.Sync"
        xmlns:local="clr-namespace:MyPersonalDrive.ViewModels.Local"
        xmlns:conv="clr-namespace:MyPersonalDrive.Views.Converters"
        xmlns:providers="clr-namespace:MyPersonalDrive.Services.Providers"
        xmlns:loc="using:MyPersonalDrive.Services.Localization"
        xmlns:views="clr-namespace:MyPersonalDrive.Views"
        x:Class="MyPersonalDrive.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MyPersonalDrive"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ToggleSettingsCommand}" />
    <KeyBinding Gesture="Cmd+OemComma" Command="{Binding ToggleSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding Console.ToggleCommandConsoleCommand}" />
    <KeyBinding Gesture="Cmd+OemTilde" Command="{Binding Console.ToggleCommandConsoleCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!--
      Per-row icon-only actions (copy/rename/download/trash on a folder row, preview/sync-now/
      pause/remove on a sync pair) stay invisible until the row is hovered or one of them gets
      keyboard focus. Opacity (not IsVisible) keeps their layout space reserved, so nothing
      shifts when they fade in — and ":pointerover" on the row container already cascades from
      any descendant the pointer is over, so hovering the row's label is enough.
    -->
    <Style Selector=".hoverGroup Button.rowAction">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=".hoverGroup:pointerover Button.rowAction">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- A listing row's five inline actions are not tab stops (docs/PLAN-UX-ROUND-3.md X5). They
         were, which put five stops on every row: tabbing past a fifty-item folder took some 250
         presses to reach whatever came after the list. Every one of them is in the row's context
         menu — reachable with Shift+F10 — and rename and trash also have F2 and Delete now, so
         nothing became unreachable by dropping them out of the traversal. The sync panel's own
         .rowAction buttons are deliberately untouched: a sync pair has no context menu, so there
         they are the only way in. -->
    <Style Selector="ListBox.driveListing Button.rowAction">
      <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!--
      Row background tint: a neutral tint on hover so any row reads as interactive, and the
      accent — reserved for "this is the important one" — on the row actually selected. Order
      matters here: ".selected" is declared after ":pointerover" so it still wins when a selected
      row is also under the pointer.
    -->
    <Style Selector="Grid.hoverGroup">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.hoverGroup:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>
    <Style Selector="Grid.hoverGroup.selected">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>

    <!-- The local pane's row root is a Button rather than a Grid (docs/INTERFACE_IMPROVEMENT_PLAN.md
         §2.2's multi-select needed a highlight there too, which it never had before). Button
         already supplies its own hover/pressed states from the theme, so only .selected needs its
         own rule here. -->
    <Style Selector="Button.hoverGroup.selected">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>

    <!--
      The listing is hosted in a ListBox for its panel and keyboard focus handling, but the row
      chrome is entirely ours (.hoverGroup / .selected above, driven by the view model's own
      selection). Flatten the ListBoxItem so the theme's padding and selection brush don't fight
      that: without this, a selected row shows two overlapping highlights of different shapes.
    -->
    <Style Selector="ListBox.driveListing">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.driveListing ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.driveListing ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Drop-target highlighting (docs/INTERFACE_IMPROVEMENT_PLAN.md Task 5 Phase 4): the whole
         pane while a valid drag is over it anywhere, and additionally the specific folder row
         when the drop would land inside that folder rather than the pane's current path. Classes
         toggled imperatively from code-behind's DragOver/DragLeave handlers — this is transient
         gesture feedback, not state the view model has any reason to know about. -->
    <Style Selector="ListBox.driveListing.dropTarget">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>
    <Style Selector="ListBox.driveListing ListBoxItem.dropTarget">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>
    <!-- The tile modes' equivalents: the whole pane while a drag is over it, the tile itself when
         the drop would land inside that folder (docs/PLAN-UX-ROUND-3.md X2). -->
    <Style Selector="ScrollViewer.dropTarget">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>
    <Style Selector="Border.tile.dropTarget">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Tile chrome, shared by the icons and gallery modes. -->
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>
    <Style Selector="Border.tile.selected">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Top Header Bar with Telemetry, Quota & Theme Switcher -->
    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource CardBackgroundBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <!-- Brand & Active Storage Provider Context -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource IconCloud}" Width="22" Height="22" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="DRIVE" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Provider Context Switcher ComboBox. Bound by index, not SelectedItem: AvailableProviders
               rebuilds fresh ProviderDescriptor instances on every access, and an index has no
               equality-matching ambiguity for Avalonia to get wrong (docs/PLAN-CLOUD-PROVIDERS.md
               P10 Appendix A2). -->
          <ComboBox ItemsSource="{Binding AvailableProviders}"
                    SelectedIndex="{Binding SelectedProviderIndex}"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Padding="10,4"
                    MinWidth="180"
                    ToolTip.Tip="{Binding Loc[header.provider.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[header.provider.tooltip]}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="providers:ProviderDescriptor">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center" Margin="2,2">
                  <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconCloud}" Width="16" Height="16" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AccountSummary}" VerticalAlignment="Center" FontSize="10" Opacity="0.6" />
                  </StackPanel>
                  <!-- A ring, not a filled dot: the header's connection badge a few pixels away is
                       a filled dot, and the two measure different things — this one is "hay sesión
                       iniciada", that one is "se puede llegar al proveedor" (U2). Same colour
                       vocabulary, deliberately different shape. -->
                  <!-- The one place that has to reach outside its own DataContext. Everywhere else
                       the DataContext is a view model, so ObservableObject.Loc is in scope and
                       {Binding Loc[key]} compiles; inside this template it is a ProviderDescriptor,
                       which has no Loc and should not grow one. Walking up to the window's view
                       model rather than naming Localizer.Instance directly is deliberate: a static
                       source cannot notify, so that binding rendered once and then never followed
                       the language picker again (docs/PLAN-I18N.md §3). -->
                  <Ellipse Grid.Column="2"
                           Width="9"
                           Height="9"
                           StrokeThickness="2"
                           Fill="Transparent"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Loc[header.session.tooltip]}"
                           AutomationProperties.Name="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Loc[header.session.tooltip]}">
                    <Ellipse.Styles>
                      <Style Selector="Ellipse.auth">
                        <Setter Property="Stroke" Value="{DynamicResource StatusOkBrush}" />
                      </Style>
                      <Style Selector="Ellipse.unauth">
                        <Setter Property="Stroke" Value="{DynamicResource StatusOfflineBrush}" />
                      </Style>
                    </Ellipse.Styles>
                    <Classes.auth>
                      <Binding Path="IsAuthenticated" />
                    </Classes.auth>
                    <Classes.unauth>
                      <Binding Path="!IsAuthenticated" />
                    </Classes.unauth>
                  </Ellipse>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Center / Right Telemetry, Quota & Theme Switcher -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <!-- The theme buttons and the local-pane toggle both set Classes.active, and the only
               Button.active style in this file is scoped to the view tabs below — so neither was
               showing its state up here. -->
          <StackPanel.Styles>
            <Style Selector="Button.active">
              <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Style>
          </StackPanel.Styles>
          <!-- Connection Status Telemetry Badge. A Button, not a Border: when the state is one the
               user can act on (Disconnected / Degraded) it retries or re-authenticates, so the app
               stops reporting a problem it won't help with (U2). Hit-testing is switched off in the
               healthy states so it reads as a plain badge. -->
          <Button Name="ConnectionBadge"
                  AutomationProperties.Name="{Binding ConnectionStatusDescription}"
                  Padding="8,4"
                  CornerRadius="6"
                  Command="{Binding StatusActionCommand}"
                  IsHitTestVisible="{Binding IsConnectionActionable}"
                  Classes.actionable="{Binding IsConnectionActionable}"
                  ToolTip.Tip="{Binding ConnectionStatusDescription}">
            <Button.Styles>
              <Style Selector="Button#ConnectionBadge">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
              </Style>
              <Style Selector="Button#ConnectionBadge.actionable">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
              </Style>
            </Button.Styles>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Styles>
                  <Style Selector="Ellipse.online">
                    <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}" />
                  </Style>
                  <Style Selector="Ellipse.syncing">
                    <Setter Property="Fill" Value="{DynamicResource StatusSyncingBrush}" />
                  </Style>
                  <Style Selector="Ellipse.ratelimited">
                    <Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
                  </Style>
                  <Style Selector="Ellipse.disconnected">
                    <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
                  </Style>
                  <Style Selector="Ellipse.degraded">
                    <Setter Property="Fill" Value="{DynamicResource StatusDegradedBrush}" />
                  </Style>
                </Ellipse.Styles>
                <Classes.online>
                  <Binding Path="IsOnline" />
                </Classes.online>
                <Classes.syncing>
                  <Binding Path="IsSyncing" />
                </Classes.syncing>
                <Classes.ratelimited>
                  <Binding Path="IsRateLimited" />
                </Classes.ratelimited>
                <Classes.disconnected>
                  <Binding Path="IsDisconnected" />
                </Classes.disconnected>
                <Classes.degraded>
                  <Binding Path="IsDegraded" />
                </Classes.degraded>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusActionLabel}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Opacity="0.75"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsConnectionActionable}" />
            </StackPanel>
          </Button>

          <!-- Storage usage. No bar and no denominator: both were drawn from a per-provider
               constant rather than from the account (docs/PLAN-UX-ROUND-4.md Y2), so the whole
               gauge now hides when there is no usage figure to show. -->
          <Border Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  Padding="8,4"
                  IsVisible="{Binding IsQuotaUsageKnown}"
                  ToolTip.Tip="{Binding QuotaTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconDatabase}" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.7" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding QuotaDisplay}" FontSize="11" FontWeight="Medium" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Theme Switcher (System / Light / Dark) -->
          <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Command="{Binding SetThemeDefaultCommand}"
                      Classes.active="{Binding IsSystemTheme}"
                      ToolTip.Tip="{Binding Loc[header.theme.system.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[header.theme.system.tooltip]}"
                      Padding="6,4">
                <Path Classes="icon" Data="{StaticResource IconMonitor}" Width="14" Height="14" />
              </Button>
              <Button Command="{Binding SetThemeLightCommand}"
                      Classes.active="{Binding IsLightTheme}"
                      ToolTip.Tip="{Binding Loc[header.theme.light.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[header.theme.light.tooltip]}"
                      Padding="6,4">
                <Path Classes="icon" Data="{StaticResource IconSun}" Width="14" Height="14" />
              </Button>
              <Button Command="{Binding SetThemeDarkCommand}"
                      Classes.active="{Binding IsDarkTheme}"
                      ToolTip.Tip="{Binding Loc[header.theme.dark.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[header.theme.dark.tooltip]}"
                      Padding="6,4">
                <Path Classes="icon" Data="{StaticResource IconMoon}" Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Show/hide the local pane. A window-level view toggle, so it sits with the other
               window-level toggles rather than in a pane's own toolbar — it was the one button in
               the explorer's old full-width header that genuinely was not about the remote pane
               (docs/PLAN-UX-ROUND-2.md §14). Persisted: the state the user leaves it in is also
               next launch's default (docs/INTERFACE_IMPROVEMENT_PLAN.md Task 3). -->
          <Button Command="{Binding ToggleLocalExplorerPanelCommand}"
                  Classes.active="{Binding IsLocalExplorerPanelVisible}"
                  IsVisible="{Binding IsExplorerView}"
                  ToolTip.Tip="{Binding Loc[header.localpane.tooltip]}"
                  AutomationProperties.Name="{Binding Loc[header.localpane.tooltip]}"
                  Padding="8,6">
            <Path Classes="icon" Data="{StaticResource IconPanelRight}" Width="14" Height="14" />
          </Button>

          <!-- Global Settings Shortcut Button -->
          <Button Command="{Binding ToggleSettingsCommand}"
                  Classes.active="{Binding IsSettingsView}"
                  ToolTip.Tip="{Binding Loc[header.settings.tooltip]}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconSettings}" Width="14" Height="14" />
              <TextBlock Text="{Binding Loc[nav.settings]}" FontSize="12" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="16,12,16,0">
      <StackPanel.Styles>
        <Style Selector="Button.active">
          <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
      </StackPanel.Styles>
      <Button Command="{Binding ShowExplorerCommand}"
              Classes.active="{Binding IsExplorerView}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{StaticResource IconExplorer}" />
          <TextBlock Text="{Binding Loc[nav.explorer]}" />
        </StackPanel>
      </Button>
      <!-- Opens the viewer on whatever row is selected. A menu entry and not only a per-row action,
           so it's discoverable without hovering a row or opening a context menu; it stays disabled
           until the selection is something the viewer can actually show (TextPreviewPolicy /
           ImagePreviewPolicy). -->
      <Button Command="{Binding ViewSelectedFileCommand}"
              Classes.active="{Binding IsViewerVisible}"
              ToolTip.Tip="{Binding Loc[nav.viewer.tooltip]}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{StaticResource IconEye}" />
          <TextBlock Text="{Binding Loc[nav.viewer]}" />
        </StackPanel>
      </Button>
      <!-- The failure dot is the point of promoting sync up here: previously you had to open
           Configuración and scroll past the whole Conexión block to discover a pair had been
           failing since last week (docs/PLAN-UX-ROUND-2.md §5). -->
      <Button Command="{Binding ShowSyncCommand}"
              Classes.active="{Binding IsSyncView}"
              ToolTip.Tip="{Binding Loc[nav.sync.tooltip]}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{StaticResource IconSync}" />
          <TextBlock Text="{Binding Loc[nav.sync]}" />
          <Ellipse Width="8"
                   Height="8"
                   Fill="{DynamicResource StatusErrorBrush}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding SyncPanel.HasFailingPairs}"
                   ToolTip.Tip="{Binding Loc[nav.sync.failures.tooltip]}"
                   AutomationProperties.Name="{Binding Loc[nav.sync.failures.tooltip]}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- The alert strip (docs/PLAN-UX-ROUND-3.md X1). Belongs to the window, not to a view and not
         to the status panel: U1 put the recovery button inside that panel, which is a preference
         the user can switch off and which only exists in the explorer view — so a failed load was
         silent for anyone who had hidden it, and every failure raised while the user was in
         Configuración or Sincronización was silent for everyone. Only warnings land here; ordinary
         progress keeps the panel's own card, which is what IsInformationalStatus splits off. -->
    <Border Grid.Row="2"
            Margin="16,12,16,0"
            Padding="12,10"
            CornerRadius="6"
            Background="{DynamicResource WarningCardBackgroundBrush}"
            IsVisible="{Binding IsStatusBannerVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <Path Grid.Column="0"
              Classes="icon"
              Data="{StaticResource IconWarning}"
              Stroke="{DynamicResource WarningCardForegroundBrush}"
              VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource WarningCardForegroundBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Classes="primary"
                Padding="12,4"
                FontSize="12"
                VerticalAlignment="Center"
                IsVisible="{Binding HasStatusAction}"
                Content="{Binding StatusActionLabel}"
                Command="{Binding StatusActionCommand}"
                ToolTip.Tip="{Binding Loc[status.action.tooltip]}" />
        <Button Grid.Column="3"
                Padding="6"
                VerticalAlignment="Center"
                Command="{Binding DismissStatusBannerCommand}"
                ToolTip.Tip="{Binding Loc[status.banner.dismiss.tooltip]}"
                AutomationProperties.Name="{Binding Loc[status.banner.dismiss.tooltip]}">
          <Path Classes="icon"
                Data="{StaticResource IconClear}"
                Width="12"
                Height="12"
                Stroke="{DynamicResource WarningCardForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <!-- Explorer view: breadcrumbs, folder browser, status panel and CLI activity log. -->
    <Grid Grid.Row="3" RowDefinitions="*,Auto" IsVisible="{Binding IsExplorerView}">
      <Grid x:Name="ExplorerColumnsGrid" Grid.Row="0" ColumnDefinitions="*,Auto,*,Auto">
        <Grid Grid.Column="0" Margin="16,0,16,16" RowDefinitions="Auto,Auto,Auto,Auto,*">
          <!-- This pane's own header, mirroring the local pane's (docs/PLAN-UX-ROUND-2.md §14).
               It used to be a full-window-width row above both panes, which pushed these six
               buttons — every one of which acts on THIS pane — against the right edge of the
               window, directly above the local pane and its separate toolbar. -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <Grid.Styles>
              <Style Selector="Button.viewMode.active">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Style>
            </Grid.Styles>

            <Border Grid.Column="0" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
              <views:BreadcrumbBar ItemsSource="{Binding BreadcrumbItems}"
                                   Label="{Binding ActiveProviderDisplayName}"
                                   Icon="{StaticResource IconCloud}" />
            </Border>

            <Button Grid.Column="1" ToolTip.Tip="{Binding Loc[explorer.back.tooltip]}" AutomationProperties.Name="{Binding Loc[explorer.back.tooltip]}" Command="{Binding BackCommand}">
              <Path Classes="icon" Data="{StaticResource IconArrowLeft}" />
            </Button>
            <Button Grid.Column="2" ToolTip.Tip="{Binding Loc[explorer.newfolder.tooltip]}" AutomationProperties.Name="{Binding Loc[explorer.newfolder.tooltip]}" Command="{Binding CreateFolderCommand}">
              <Path Classes="icon" Data="{StaticResource IconFolderPlus}" />
            </Button>
            <Button Grid.Column="3" ToolTip.Tip="{Binding Loc[explorer.upload.tooltip]}" AutomationProperties.Name="{Binding Loc[explorer.upload.tooltip]}" Command="{Binding UploadCommand}">
              <Path Classes="icon" Data="{StaticResource IconUpload}" />
            </Button>

            <!-- View mode: list / icons / gallery. Only the presentation changes; the listing and
                 the current selection are untouched (docs/PLAN-BROWSER-VIEWS.md V1). -->
            <Button Grid.Column="4"
                    Classes="viewMode"
                    Classes.active="{Binding IsListView}"
                    ToolTip.Tip="{Binding Loc[explorer.view.list.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[explorer.view.list.tooltip]}"
                    Command="{Binding ShowListViewCommand}">
              <Path Classes="icon" Data="{StaticResource IconViewList}" />
            </Button>
            <Button Grid.Column="5"
                    Classes="viewMode"
                    Classes.active="{Binding IsIconsView}"
                    ToolTip.Tip="{Binding Loc[explorer.view.icons.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[explorer.view.icons.tooltip]}"
                    Command="{Binding ShowIconsViewCommand}">
              <Path Classes="icon" Data="{StaticResource IconViewGrid}" />
            </Button>
            <Button Grid.Column="6"
                    Classes="viewMode"
                    Classes.active="{Binding IsGalleryView}"
                    ToolTip.Tip="{Binding Loc[explorer.view.gallery.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[explorer.view.gallery.tooltip]}"
                    Command="{Binding ShowGalleryViewCommand}">
              <Path Classes="icon" Data="{StaticResource IconViewGallery}" />
            </Button>
          </Grid>

          <!-- One sort control for all three modes rather than column headers in list mode plus a
               separate control for the tiles: the state is the same either way, and two ways to set
               it means two places to keep in step (docs/PLAN-BROWSER-VIEWS.md V4). Sorting is done
               in memory over the rows already loaded, so it costs no CLI call. -->
          <!-- WrapPanel, not StackPanel: this row carries a search box, a clear button, a result
               count, a label, four sort buttons and a filter summary, and at a narrow window a
               horizontal StackPanel pushes the tail of that off the pane instead of reflowing it
               (docs/PLAN-UX-ROUND-3.md X7). The kind chips below already wrap. -->
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <WrapPanel.Styles>
              <!-- A WrapPanel has no Spacing, so the 4px the StackPanel used to add between
                   children comes from the children now. -->
              <Style Selector="Button.sortKey">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,4,4" />
              </Style>
              <Style Selector="WrapPanel > TextBox">
                <Setter Property="Margin" Value="0,0,4,4" />
              </Style>
              <Style Selector="Button.sortKey.active">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
              </Style>
            </WrapPanel.Styles>
            <!-- Quick filter over the folder's names (docs/INTERFACE_IMPROVEMENT_PLAN.md §2.1's
                 "Global Quick Search") — narrows what's already loaded, no CLI call, combines with
                 the kind chips below rather than replacing them. -->
            <!-- U9 (docs/PLAN-UX-ROUND-2.md §9): the box used to hide rows without saying how many
                 it hid, and the only way out was selecting the text and deleting it. -->
            <TextBox x:Name="CloudSearchBox"
                     Width="200"
                     PlaceholderText="{Binding Loc[explorer.search.placeholder]}"
                     AutomationProperties.Name="{Binding Loc[explorer.search.placeholder]}"
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <Button Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding HasSearchText}"
                    Padding="6,2"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Loc[explorer.search.clear.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[explorer.search.clear.tooltip]}">
              <Path Classes="icon" Data="{StaticResource IconClear}" Width="12" Height="12" />
            </Button>
            <TextBlock Text="{Binding SearchResultText}"
                       IsVisible="{Binding HasSearchText}"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       FontSize="12"
                       Margin="6,0,8,0" />
            <TextBlock Text="{Binding Loc[explorer.sort.label]}" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByName}" Command="{Binding SortByNameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.name]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByName}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedBySize}" Command="{Binding SortBySizeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.size]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedBySize}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByModified}" Command="{Binding SortByModifiedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.modified]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByModified}" FontSize="10" />
              </StackPanel>
            </Button>
            <Button Classes="sortKey" Classes.active="{Binding IsSortedByKind}" Command="{Binding SortByKindCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Loc[common.type]}" />
                <TextBlock Text="{Binding SortDirectionGlyph}" IsVisible="{Binding IsSortedByKind}" FontSize="10" />
              </StackPanel>
            </Button>

            <TextBlock Text="{Binding FilterSummary}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Opacity="0.7"
                       FontSize="12"
                       IsVisible="{Binding FilterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </WrapPanel>

          <!-- Batch action bar (docs/INTERFACE_IMPROVEMENT_PLAN.md §2.2) — only worth showing once
               Ctrl/Shift+Click or Ctrl+A has actually marked more than one row; a single selection
               already has its own row-level actions (inline buttons, context menu). -->
          <Border Grid.Row="2"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  CornerRadius="6"
                  Background="{DynamicResource AccentMutedBrush}"
                  IsVisible="{Binding HasMultipleSelected}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding SelectionSummaryText}" />
              <Button Content="{Binding Loc[explorer.download.selected]}" Command="{Binding DownloadSelectedCommand}" />
              <Button Content="{Binding Loc[menu.trash]}" Command="{Binding TrashSelectedCommand}" />
            </StackPanel>
          </Border>

          <!-- Filter by type. The chips come from the metrics histogram, so they only ever offer
               kinds the folder actually contains (docs/PLAN-BROWSER-VIEWS.md M6). Filtering is a
               view of what was already loaded - it makes no CLI call, and it does not change the
               metrics panel, which keeps describing the whole folder. -->
          <ItemsControl Grid.Row="3" ItemsSource="{Binding KindFilters}" Margin="0,0,0,8">
            <ItemsControl.Styles>
              <Style Selector="Button.kindChip">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,6,6" />
              </Style>
              <Style Selector="Button.kindChip.active">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KindFilterViewModel">
                <Button Classes="kindChip"
                        Classes.active="{Binding IsActive}"
                        Command="{Binding ApplyCommand}"
                        Content="{Binding LabelWithCount}"
                        ToolTip.Tip="{Binding Loc[explorer.kindfilter.tooltip]}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Grid.Row="4">
          <!-- Unauthenticated / Expired Session Fallback Card -->
          <Border IsVisible="{Binding !IsAuthenticated}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="8"
                  Padding="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="480">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconKey}" Width="36" Height="36" Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Loc[auth.required.title]}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" />
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Classes="primary" Content="{Binding Loc[auth.signin]}" Command="{Binding AuthenticateCommand}" Padding="16,8" />
                <Button Content="{Binding Loc[nav.settings]}" Command="{Binding ToggleSettingsCommand}" Padding="16,8" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- List mode: the original row, one per line, with the per-row actions inline. -->
          <ListBox x:Name="ListModeListing"
                   Classes="driveListing"
                   ItemsSource="{Binding RootItems}"
                   IsVisible="{Binding IsListView}"
                   KeyDown="OnListingKeyDown"
                   DragDrop.AllowDrop="True"
                   DragDrop.DragOver="OnCloudListingDragOver"
                   DragDrop.DragLeave="OnCloudListingDragLeave"
                   DragDrop.Drop="OnCloudListingDrop">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DriveNodeViewModel">
                <Grid Classes="hoverGroup"
                      Classes.selected="{Binding IsSelected}"
                      ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
                      Margin="0,0,0,6">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <!-- Open is an entry here now: a plain click selects rather than opens
                           (docs/PLAN-UX-ROUND-3.md X2), so the menu has to carry the verb the
                           tile modes' menus always did. -->
                      <MenuItem Header="{Binding Loc[menu.open]}" Command="{Binding ActivateCommand}" />
                      <!-- The five that used to be inline-only. They are how the row's actions stay
                           reachable now that the inline buttons are out of the tab order (X5), and
                           they make this menu the same menu the tile modes already offered. -->
                      <MenuItem Header="{Binding Loc[menu.preview]}" Command="{Binding PreviewCommand}" IsVisible="{Binding CanPreview}" />
                      <MenuItem Header="{Binding Loc[menu.copy]}" Command="{Binding CopyCommand}" />
                      <MenuItem Header="{Binding Loc[menu.rename]}" Command="{Binding RenameCommand}" />
                      <MenuItem Header="{Binding Loc[menu.download]}"
                                Command="{Binding DownloadCommand}"
                                IsVisible="{Binding IsFile}"
                                IsEnabled="{Binding CanDownload}"
                                ToolTip.Tip="{Binding DownloadTooltip}"
                                ToolTip.ShowOnDisabled="True" />
                      <MenuItem Header="{Binding Loc[menu.trash]}" Command="{Binding TrashCommand}" />
                      <Separator />
                      <MenuItem Header="{Binding Loc[menu.downloadhere]}" Command="{Binding DownloadHereCommand}" />
                      <MenuItem Header="{Binding Loc[menu.uploadhere]}" Command="{Binding UploadToFolderCommand}" IsVisible="{Binding IsFolder}" />
                      <MenuItem Header="{Binding Loc[menu.copypath]}" Command="{Binding CopyPathCommand}" />
                      <MenuItem Header="{Binding Loc[menu.copysharelink]}"
                                Command="{Binding ShareLinkCommand}"
                                IsEnabled="{Binding CanShareLink}"
                                ToolTip.Tip="{Binding ShareLinkTooltip}"
                                ToolTip.ShowOnDisabled="True" />
                      <Separator IsVisible="{Binding IsFolder}" />
                      <MenuItem Header="{Binding Loc[menu.syncpath]}" Command="{Binding SyncSelectedPathCommand}" IsVisible="{Binding CanCreateSyncPair}" />
                      <MenuItem Header="{Binding Loc[menu.syncnow]}" Command="{Binding SyncPair.SyncNowCommand}" IsVisible="{Binding HasSyncPair}" />
                      <MenuItem Header="{Binding Loc[menu.syncpause]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairActive}" />
                      <MenuItem Header="{Binding Loc[menu.syncresume]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairPaused}" />
                      <Separator />
                      <MenuItem Header="{Binding Loc[menu.properties]}" Command="{Binding PropertiesCommand}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Button Grid.Column="0"
                          Command="{Binding SelectCommand}"
                          ToolTip.Tip="{Binding Loc[explorer.row.open.tooltip]}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Focusable="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="icon" Data="{StaticResource IconFolder}" IsVisible="{Binding IsFolder}" />
                      <Path Classes="icon" Data="{StaticResource IconFile}" IsVisible="{Binding IsFile}" />
                      <!-- Trimmed, like the tiles and the local pane already were: without this a
                           long name widens its own row past the others and, in a narrow window,
                           pushes the row's actions out of the pane (docs/PLAN-UX-ROUND-4.md Y5). -->
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="12" Height="12" Opacity="0.7"
                            IsVisible="{Binding IsSyncPairActive}" ToolTip.Tip="{Binding Loc[explorer.row.syncactive.tooltip]}" />
                      <Path Classes="icon" Data="{StaticResource IconPause}" Width="12" Height="12" Opacity="0.7"
                            IsVisible="{Binding IsSyncPairPaused}" ToolTip.Tip="{Binding Loc[explorer.row.syncpaused.tooltip]}" />
                    </StackPanel>
                  </Button>

                  <!-- The folder's recursive size, when someone has already scanned it. Files show
                       nothing here: their size is already in the details panel. -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding DeepSizeText}"
                             IsVisible="{Binding HasDeepSize}"
                             VerticalAlignment="Center"
                             Margin="8,0"
                             FontSize="12"
                             Opacity="0.7" />

                  <Button Grid.Column="2"
                          Classes="rowAction"
                          ToolTip.Tip="{Binding Loc[menu.preview]}"
                          AutomationProperties.Name="{Binding Loc[menu.preview]}"
                          Margin="8,0,0,0"
                          Command="{Binding PreviewCommand}"
                          IsVisible="{Binding CanPreview}">
                    <Path Classes="icon" Data="{StaticResource IconEye}" />
                  </Button>

                  <Button Grid.Column="3"
                          Classes="rowAction"
                          ToolTip.Tip="{Binding Loc[menu.copy]}"
                          AutomationProperties.Name="{Binding Loc[menu.copy]}"
                          Margin="8,0,0,0"
                          Command="{Binding CopyCommand}">
                    <Path Classes="icon" Data="{StaticResource IconCopy}" />
                  </Button>

                  <Button Grid.Column="4"
                          Classes="rowAction"
                          ToolTip.Tip="{Binding Loc[explorer.row.rename.tooltip]}"
                          AutomationProperties.Name="{Binding Loc[explorer.row.rename.tooltip]}"
                          Margin="8,0,0,0"
                          Command="{Binding RenameCommand}">
                    <Path Classes="icon" Data="{StaticResource IconPencil}" />
                  </Button>

                  <Button Grid.Column="5"
                          Classes="rowAction"
                          ToolTip.Tip="{Binding DownloadTooltip}"
                          AutomationProperties.Name="{Binding DownloadTooltip}"
                          Margin="8,0,0,0"
                          Command="{Binding DownloadCommand}"
                          IsVisible="{Binding IsFile}">
                    <Path Classes="icon" Data="{StaticResource IconDownload}" />
                  </Button>

                  <Button Grid.Column="6"
                          Classes="rowAction"
                          ToolTip.Tip="{Binding Loc[menu.trash]}"
                          AutomationProperties.Name="{Binding Loc[menu.trash]}"
                          Margin="8,0,0,0"
                          Command="{Binding TrashCommand}">
                    <Path Classes="icon" Data="{StaticResource IconTrash}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Icons mode: a dense grid. The five row actions don't fit on a 112px tile, so they
               move into a context menu bound to the same commands.

               ItemsRepeater + UniformGridLayout rather than a ListBox over a WrapPanel: WrapPanel
               materializes every child, so a folder with thousands of items would build thousands of
               tiles up front (docs/PLAN-BROWSER-VIEWS.md §3). ItemsRepeater virtualizes, at the cost
               of having no selection or keyboard model of its own - which costs this app nothing,
               because row selection is the view model's (Classes.selected on IsSelected) and
               activation is the tile's own Button. -->
          <ScrollViewer IsVisible="{Binding IsIconsView}"
                        HorizontalScrollBarVisibility="Disabled"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnCloudListingDragOver"
                        DragDrop.DragLeave="OnCloudListingDragLeave"
                        DragDrop.Drop="OnCloudListingDrop">
          <ItemsRepeater x:Name="IconsModeListing" ItemsSource="{Binding RootItems}">
            <ItemsRepeater.Layout>
              <UniformGridLayout ItemsStretch="Fill" MinItemWidth="112" MinItemHeight="112" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:DriveNodeViewModel">
                <Border Classes="tile" Classes.selected="{Binding IsSelected}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{Binding Loc[menu.open]}" Command="{Binding ActivateCommand}" />
                      <MenuItem Header="{Binding Loc[menu.preview]}" Command="{Binding PreviewCommand}" IsVisible="{Binding CanPreview}" />
                      <MenuItem Header="{Binding Loc[menu.copy]}" Command="{Binding CopyCommand}" />
                      <MenuItem Header="{Binding Loc[menu.rename]}" Command="{Binding RenameCommand}" />
                      <MenuItem Header="{Binding Loc[menu.download]}"
                                Command="{Binding DownloadCommand}"
                                IsVisible="{Binding IsFile}"
                                IsEnabled="{Binding CanDownload}"
                                ToolTip.Tip="{Binding DownloadTooltip}"
                                ToolTip.ShowOnDisabled="True" />
                      <MenuItem Header="{Binding Loc[menu.downloadhere]}" Command="{Binding DownloadHereCommand}" />
                      <MenuItem Header="{Binding Loc[menu.uploadhere]}" Command="{Binding UploadToFolderCommand}" IsVisible="{Binding IsFolder}" />
                      <MenuItem Header="{Binding Loc[menu.copypath]}" Command="{Binding CopyPathCommand}" />
                      <MenuItem Header="{Binding Loc[menu.copysharelink]}"
                                Command="{Binding ShareLinkCommand}"
                                IsEnabled="{Binding CanShareLink}"
                                ToolTip.Tip="{Binding ShareLinkTooltip}"
                                ToolTip.ShowOnDisabled="True" />
                      <Separator IsVisible="{Binding IsFolder}" />
                      <MenuItem Header="{Binding Loc[menu.syncpath]}" Command="{Binding SyncSelectedPathCommand}" IsVisible="{Binding CanCreateSyncPair}" />
                      <MenuItem Header="{Binding Loc[menu.syncnow]}" Command="{Binding SyncPair.SyncNowCommand}" IsVisible="{Binding HasSyncPair}" />
                      <MenuItem Header="{Binding Loc[menu.syncpause]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairActive}" />
                      <MenuItem Header="{Binding Loc[menu.syncresume]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairPaused}" />
                      <Separator />
                      <MenuItem Header="{Binding Loc[menu.trash]}" Command="{Binding TrashCommand}" />
                      <MenuItem Header="{Binding Loc[menu.properties]}" Command="{Binding PropertiesCommand}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Button Command="{Binding SelectCommand}"
                          ToolTip.Tip="{Binding DisplayName}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                      <Path Classes="icon"
                            Width="32"
                            Height="32"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            Data="{Binding FileKind, Converter={x:Static conv:FileKindIconConverter.Instance}}" />
                      <TextBlock Text="{Binding DisplayName}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis"
                                 FontSize="12" />
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          </ScrollViewer>

          <!-- Gallery mode: large tiles with a metadata line. Deliberately NOT image previews -
               the CLI exposes no thumbnails, and generating them would mean downloading every file
               (docs/PLAN-BROWSER-VIEWS.md §7). -->
          <ScrollViewer IsVisible="{Binding IsGalleryView}"
                        HorizontalScrollBarVisibility="Disabled"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnCloudListingDragOver"
                        DragDrop.DragLeave="OnCloudListingDragLeave"
                        DragDrop.Drop="OnCloudListingDrop">
          <ItemsRepeater x:Name="GalleryModeListing" ItemsSource="{Binding RootItems}">
            <ItemsRepeater.Layout>
              <UniformGridLayout ItemsStretch="Fill" MinItemWidth="176" MinItemHeight="200" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:DriveNodeViewModel">
                <Border Classes="tile" Classes.selected="{Binding IsSelected}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{Binding Loc[menu.open]}" Command="{Binding ActivateCommand}" />
                      <MenuItem Header="{Binding Loc[menu.preview]}" Command="{Binding PreviewCommand}" IsVisible="{Binding CanPreview}" />
                      <MenuItem Header="{Binding Loc[menu.copy]}" Command="{Binding CopyCommand}" />
                      <MenuItem Header="{Binding Loc[menu.rename]}" Command="{Binding RenameCommand}" />
                      <MenuItem Header="{Binding Loc[menu.download]}"
                                Command="{Binding DownloadCommand}"
                                IsVisible="{Binding IsFile}"
                                IsEnabled="{Binding CanDownload}"
                                ToolTip.Tip="{Binding DownloadTooltip}"
                                ToolTip.ShowOnDisabled="True" />
                      <MenuItem Header="{Binding Loc[menu.downloadhere]}" Command="{Binding DownloadHereCommand}" />
                      <MenuItem Header="{Binding Loc[menu.uploadhere]}" Command="{Binding UploadToFolderCommand}" IsVisible="{Binding IsFolder}" />
                      <MenuItem Header="{Binding Loc[menu.copypath]}" Command="{Binding CopyPathCommand}" />
                      <MenuItem Header="{Binding Loc[menu.copysharelink]}"
                                Command="{Binding ShareLinkCommand}"
                                IsEnabled="{Binding CanShareLink}"
                                ToolTip.Tip="{Binding ShareLinkTooltip}"
                                ToolTip.ShowOnDisabled="True" />
                      <Separator IsVisible="{Binding IsFolder}" />
                      <MenuItem Header="{Binding Loc[menu.syncpath]}" Command="{Binding SyncSelectedPathCommand}" IsVisible="{Binding CanCreateSyncPair}" />
                      <MenuItem Header="{Binding Loc[menu.syncnow]}" Command="{Binding SyncPair.SyncNowCommand}" IsVisible="{Binding HasSyncPair}" />
                      <MenuItem Header="{Binding Loc[menu.syncpause]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairActive}" />
                      <MenuItem Header="{Binding Loc[menu.syncresume]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairPaused}" />
                      <Separator />
                      <MenuItem Header="{Binding Loc[menu.trash]}" Command="{Binding TrashCommand}" />
                      <MenuItem Header="{Binding Loc[menu.properties]}" Command="{Binding PropertiesCommand}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Button Command="{Binding SelectCommand}"
                          ToolTip.Tip="{Binding DisplayName}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                      <Border Background="{DynamicResource CardBackgroundBrush}"
                              CornerRadius="6"
                              Height="96"
                              Padding="12">
                        <Path Classes="icon"
                              Width="64"
                              Height="64"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{Binding FileKind, Converter={x:Static conv:FileKindIconConverter.Instance}}" />
                      </Border>
                      <TextBlock Text="{Binding DisplayName}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SizeText}"
                                 TextAlignment="Center"
                                 Opacity="0.7"
                                 FontSize="12"
                                 IsVisible="{Binding SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding DeepSizeText}"
                                 TextAlignment="Center"
                                 Opacity="0.7"
                                 FontSize="12"
                                 IsVisible="{Binding HasDeepSize}" />
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          </ScrollViewer>

          <!-- Empty state (docs/PLAN-UX-ROUND-3.md X3). Three situations that used to render as the
               same blank rectangle: an empty folder, a search that matched nothing, and a kind chip
               hiding everything. The last two are the ones with a way out, so they get the button —
               clicking the active chip also clears it, but nobody staring at an empty pane knows
               that. Shares this cell with the three view modes and the sign-in card; IsListingEmpty
               already requires a session and a finished load, so it cannot collide with either. -->
          <StackPanel IsVisible="{Binding IsListingEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="380"
                      Spacing="10">
            <Path Classes="icon"
                  Data="{StaticResource IconFolder}"
                  Width="32"
                  Height="32"
                  Opacity="0.5"
                  HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ListingEmptyTitle}"
                       FontSize="16"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ListingEmptyDetail}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Opacity="0.7" />
            <Button Content="{Binding Loc[explorer.empty.clearfilters]}"
                    Command="{Binding ClearFiltersCommand}"
                    IsVisible="{Binding IsListingFilteredToNothing}"
                    HorizontalAlignment="Center"
                    Padding="12,6" />
          </StackPanel>

          <!-- Drop-target badge (docs/INTERFACE_IMPROVEMENT_PLAN.md Task 5 Phase 4) — shown only
               while a local item is being dragged over this pane. Last child of the overlapping
               Grid.Row="2" (List/Icons/Gallery/auth-fallback all share this cell), so it always
               paints on top regardless of which view mode is active. Text/visibility toggled from
               code-behind's drag handlers, not bound to VM state — purely transient UI feedback
               for a gesture the VM never sees. -->
          <Border x:Name="CloudDropOverlay"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,12,0,0"
                  Padding="12,8"
                  CornerRadius="6"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource AccentBrush}"
                  Background="{DynamicResource AccentMutedBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconUpload}" Width="14" Height="14" Stroke="{DynamicResource AccentBrush}" />
              <TextBlock x:Name="CloudDropOverlayText" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
            </StackPanel>
          </Border>
          </Grid>
        </Grid>

        <!-- Adjustable split between the cloud and local panes (docs/INTERFACE_IMPROVEMENT_PLAN.md
             Task 3). Drag resizes both star-sized columns automatically; double-click resets them
             to 50/50 via ExplorerSplitter_DoubleTapped (Avalonia's GridSplitter has no built-in
             reset gesture). -->
        <GridSplitter x:Name="ExplorerSplitter"
                      Grid.Column="1"
                      Width="6"
                      Margin="4,16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource CardBackgroundBrush}"
                      Cursor="SizeWestEast"
                      ResizeDirection="Columns"
                      DoubleTapped="ExplorerSplitter_DoubleTapped"
                      IsVisible="{Binding IsLocalExplorerPanelVisible}"
                      ToolTip.Tip="{Binding Loc[explorer.splitter.tooltip]}" />

        <!-- Local pane: read-only browsing only (navigate, breadcrumb, home, hidden-files toggle,
             free space). File operations and drag-and-drop transfer are separate plan tasks.
             Hidden/shown via ToggleLocalExplorerPanelCommand; ExplorerColumnsGrid's own Column[2]
             width is collapsed to 0 alongside this in MainWindow.axaml.cs, since a star-sized
             column doesn't shrink on its own just because its content is invisible. IsVisible sits
             on this outer Grid (still bound to the window's own DataContext) rather than the inner
             one, which switches DataContext to LocalExplorer and so can't see this VM's property. -->
        <Grid x:Name="LocalPane" Grid.Column="2" Margin="0,0,16,16" IsVisible="{Binding IsLocalExplorerPanelVisible}">
        <Grid RowDefinitions="Auto,*" DataContext="{Binding LocalExplorer}">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <Grid.Styles>
              <Style Selector="Button.viewMode.active">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Style>
            </Grid.Styles>
            <Border Grid.Column="0" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
              <StackPanel Spacing="4">
                <views:BreadcrumbBar ItemsSource="{Binding BreadcrumbItems}"
                                     Label="{Binding Loc[local.breadcrumb.label]}"
                                     Icon="{StaticResource IconHome}" />
              <!-- Quick filter over this folder's names — the local pane's counterpart to the
                   cloud pane's own search box (docs/INTERFACE_IMPROVEMENT_PLAN.md §2.1). -->
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                <TextBox x:Name="LocalSearchBox"
                         Width="200"
                         PlaceholderText="{Binding Loc[explorer.search.placeholder]}"
                         AutomationProperties.Name="{Binding Loc[explorer.search.placeholder]}"
                         Text="{Binding SearchText, Mode=TwoWay}" />
                <Button Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding HasSearchText}"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding Loc[explorer.search.clear.tooltip]}"
                        AutomationProperties.Name="{Binding Loc[explorer.search.clear.tooltip]}">
                  <Path Classes="icon" Data="{StaticResource IconClear}" Width="12" Height="12" />
                </Button>
                <TextBlock Text="{Binding SearchResultText}"
                           IsVisible="{Binding HasSearchText}"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           FontSize="12" />
              </StackPanel>
              </StackPanel>
            </Border>

            <Button Grid.Column="1" ToolTip.Tip="{Binding Loc[local.home.tooltip]}" AutomationProperties.Name="{Binding Loc[local.home.tooltip]}" Command="{Binding GoHomeCommand}">
              <Path Classes="icon" Data="{StaticResource IconHome}" />
            </Button>
            <Button Grid.Column="2"
                    Classes="viewMode"
                    Classes.active="{Binding ShowHiddenFiles}"
                    ToolTip.Tip="{Binding Loc[local.hidden.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[local.hidden.tooltip]}"
                    Command="{Binding ToggleHiddenFilesCommand}">
              <Path Classes="icon" Data="{StaticResource IconEyeOff}" />
            </Button>
            <Button Grid.Column="3" ToolTip.Tip="{Binding Loc[common.refresh]}" AutomationProperties.Name="{Binding Loc[common.refresh]}" Command="{Binding RefreshCommand}">
              <Path Classes="icon" Data="{StaticResource IconRefresh}" />
            </Button>
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       FontSize="12"
                       Text="{Binding FreeSpaceLabel}" />
          </Grid>

          <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Batch action bar — the local pane's counterpart to the cloud pane's own
                 (docs/INTERFACE_IMPROVEMENT_PLAN.md §2.2). -->
            <Border Grid.Row="1"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    CornerRadius="6"
                    Background="{DynamicResource AccentMutedBrush}"
                    IsVisible="{Binding HasMultipleSelected}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding SelectionSummaryText}" />
                <Button Content="{Binding Loc[local.delete.selected]}" Command="{Binding DeleteSelectedCommand}" />
              </StackPanel>
            </Border>

            <ListBox x:Name="LocalListing"
                     Grid.Row="2"
                     Classes="driveListing"
                     ItemsSource="{Binding Items}"
                     DragDrop.AllowDrop="True"
                     DragDrop.DragOver="OnLocalListingDragOver"
                     DragDrop.DragLeave="OnLocalListingDragLeave"
                     DragDrop.Drop="OnLocalListingDrop">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:LocalNodeViewModel">
                  <!-- HorizontalAlignment as well as HorizontalContentAlignment: Fluent's Button
                       aligns itself Left, so the row hugged its own text and stopped there. The
                       ListBox and the ListBoxItem were already full width — measured, after a
                       first attempt at this fixed the wrong two of the three
                       (docs/PLAN-UX-ROUND-3.md X7). Without it the local pane's Size and Modified
                       columns land at a different x on every line, and the hover highlight covers
                       only the name. The cloud pane's rows never had this: their root is a Grid,
                       which stretches by default. -->
                  <Button Classes="hoverGroup"
                          Classes.selected="{Binding IsSelected}"
                          Command="{Binding SelectCommand}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding Loc[menu.copypath]}" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="{Binding Loc[menu.rename]}" Command="{Binding RenameCommand}" />
                        <Separator IsVisible="{Binding IsFolder}" />
                        <MenuItem Header="{Binding Loc[menu.syncpath]}" Command="{Binding SyncSelectedPathCommand}" IsVisible="{Binding CanCreateSyncPair}" />
                        <MenuItem Header="{Binding Loc[menu.syncnow]}" Command="{Binding SyncPair.SyncNowCommand}" IsVisible="{Binding HasSyncPair}" />
                        <MenuItem Header="{Binding Loc[menu.syncpause]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairActive}" />
                        <MenuItem Header="{Binding Loc[menu.syncresume]}" Command="{Binding TogglePauseSyncCommand}" IsVisible="{Binding IsSyncPairPaused}" />
                        <Separator />
                        <MenuItem Header="{Binding Loc[menu.delete]}" Command="{Binding DeleteCommand}" />
                        <MenuItem Header="{Binding Loc[menu.properties]}" Command="{Binding PropertiesCommand}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                      <Path Grid.Column="0"
                            Classes="icon"
                            Width="18"
                            Height="18"
                            Data="{Binding FileKind, Converter={x:Static conv:FileKindIconConverter.Instance}}" />
                      <TextBlock Grid.Column="1"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding DisplayName}" />
                      <Path Grid.Column="2"
                            Classes="icon"
                            Width="12"
                            Height="12"
                            Opacity="0.7"
                            VerticalAlignment="Center"
                            Data="{StaticResource IconRefresh}"
                            IsVisible="{Binding IsSyncPairActive}"
                            ToolTip.Tip="{Binding Loc[explorer.row.syncactive.tooltip]}" />
                      <Path Grid.Column="2"
                            Classes="icon"
                            Width="12"
                            Height="12"
                            Opacity="0.7"
                            VerticalAlignment="Center"
                            Data="{StaticResource IconPause}"
                            IsVisible="{Binding IsSyncPairPaused}"
                            ToolTip.Tip="{Binding Loc[explorer.row.syncpaused.tooltip]}" />
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Opacity="0.8"
                                 Text="{Binding SizeText}" />
                      <TextBlock Grid.Column="4"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Opacity="0.7"
                                 Text="{Binding ModifiedText}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state, mirroring the cloud pane's (docs/PLAN-UX-ROUND-3.md X3). No filter
                 button: this pane has a search box and no kind chips, so clearing the box is the
                 whole remedy and its own control is right there above the listing. -->
            <StackPanel Grid.Row="2"
                        IsVisible="{Binding IsListingEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320"
                        Spacing="10">
              <Path Classes="icon"
                    Data="{StaticResource IconFolder}"
                    Width="28"
                    Height="28"
                    Opacity="0.5"
                    HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ListingEmptyTitle}"
                         FontSize="15"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ListingEmptyDetail}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Opacity="0.7" />
            </StackPanel>

            <!-- Drop-target badge — mirrors CloudDropOverlay for this pane (docs/
                 INTERFACE_IMPROVEMENT_PLAN.md Task 5 Phase 4). -->
            <Border x:Name="LocalDropOverlay"
                    Grid.Row="2"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,12,0,0"
                    Padding="12,8"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource AccentMutedBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource IconDownload}" Width="14" Height="14" Stroke="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="LocalDropOverlayText" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
        </Grid>

        <Border Grid.Column="3" Margin="0,0,16,16" Padding="16" Width="340" Background="{DynamicResource CardBackgroundBrush}" IsVisible="{Binding IsStatusPanelVisible}">
          <!-- Scrollable since the metrics section landed: status + selection + metrics is taller
               than the panel on a short window, and a clipped histogram is worse than a scrollbar. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock FontSize="18" Text="{Binding Loc[status.title]}" />

            <!-- Drag-and-drop transfer queue (docs/INTERFACE_IMPROVEMENT_PLAN.md Task 5). Only
                 status text and a Cancel button — no progress bar/ETA, since nothing in the CLI
                 wrapper reports byte-level progress to build one from (see
                 TransferQueueViewModel's own doc comment). -->
            <StackPanel Spacing="6" IsVisible="{Binding TransferQueue.HasItems}">
              <TextBlock FontWeight="Bold" Text="{Binding TransferQueue.Summary}" />
              <ItemsControl ItemsSource="{Binding TransferQueue.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TransferItemViewModel">
                    <Border Padding="8" Margin="0,0,0,4" CornerRadius="4" Background="{DynamicResource PanelBackgroundBrush}">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SourceLabel}" />
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Padding="4"
                                Command="{Binding CancelCommand}"
                                ToolTip.Tip="{Binding Loc[common.cancel]}"
                                AutomationProperties.Name="{Binding Loc[common.cancel]}">
                          <Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClear}" />
                        </Button>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   FontSize="11"
                                   Opacity="0.7"
                                   Text="{Binding StatusText}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Progress and results only. A warning goes to the window-level alert strip
                 instead (docs/PLAN-UX-ROUND-3.md X1), so the same sentence is never rendered
                 twice on one screen — and so hiding this panel cannot hide a failure. -->
            <Border Name="StatusBorder"
                    Padding="8"
                    CornerRadius="4"
                    IsVisible="{Binding IsInformationalStatus}">
              <TextBlock Name="StatusText"
                         TextWrapping="Wrap"
                         Text="{Binding StatusMessage}"
                         VerticalAlignment="Center" />
            </Border>

            <TextBlock Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="{Binding Loc[status.empty.details]}"
                       IsVisible="{Binding !HasSelection}" />

            <!-- Multi-select summary (docs/INTERFACE_IMPROVEMENT_PLAN.md §2.2) replaces the
                 single-item details below once more than one row is marked — "the size" of three
                 different files isn't one field. -->
            <StackPanel Spacing="10" IsVisible="{Binding HasMultipleSelected}">
              <TextBlock FontWeight="Bold" Text="{Binding SelectionSummaryText}" />
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Loc[status.empty.hint]}" />
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding IsSingleSelected}">
              <TextBlock FontWeight="Bold" Text="{Binding Loc[status.selected.title]}" />
              <TextBlock Text="{Binding SelectedName}" />
              <TextBlock FontWeight="Bold" Text="{Binding Loc[common.type]}" />
              <TextBlock Text="{Binding SelectedKind}" />
              <TextBlock FontWeight="Bold" Text="{Binding Loc[common.path]}" />
              <TextBlock TextWrapping="Wrap" Text="{Binding SelectedPath}" />
              <TextBlock FontWeight="Bold" Text="{Binding Loc[common.size]}" />
              <TextBlock Text="{Binding SelectedSize}" />
              <TextBlock FontWeight="Bold" Text="{Binding Loc[common.modified]}" />
              <TextBlock TextWrapping="Wrap" Text="{Binding SelectedModified}" />
              <TextBlock FontWeight="Bold" Text="{Binding Loc[common.owner]}" />
              <TextBlock TextWrapping="Wrap" Text="{Binding SelectedOwner}" />
              <TextBlock FontWeight="Bold" Text="{Binding Loc[common.shared]}" />
              <TextBlock Text="{Binding SelectedShared}" />
            </StackPanel>

            <!-- Métricas: computed from the listing already on screen, so it costs nothing.
                 Shallow by design - a recursive total needs a multi-minute scan per folder on this
                 CLI (docs/PLAN-BROWSER-VIEWS.md M2/M3), which is why ScopeNote spells out what the
                 total leaves out instead of letting it read as recursive. -->
            <Border Height="1" Background="{DynamicResource CardBackgroundBrush}" Margin="0,4" />
            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Loc[metrics.title]}" />
            <TextBlock Text="{Binding Metrics.Headline}" />

            <StackPanel Spacing="10" IsVisible="{Binding Metrics.HasItems}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="Bold" Text="{Binding Metrics.TotalSizeText}" FontSize="18" />
                <TextBlock Text="{Binding Metrics.TotalSizeCaption}" TextWrapping="Wrap" VerticalAlignment="Bottom" Opacity="0.7" FontSize="12" />
              </StackPanel>
              <TextBlock Text="{Binding Metrics.DepthNote}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Opacity="0.8"
                         IsVisible="{Binding Metrics.DepthNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding Metrics.ScopeNote}"
                         TextWrapping="Wrap"
                         Opacity="0.7"
                         FontSize="12"
                         IsVisible="{Binding Metrics.ScopeNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- The recursive scan. Explicitly user-initiated and labelled with its cost: on this
                   CLI it is one ~3.5s process per subfolder (docs/PLAN-BROWSER-VIEWS.md M3), so it
                   must never fire on navigation. -->
              <Button Command="{Binding ScanFolderDeeplyCommand}"
                      IsVisible="{Binding !Metrics.IsScanning}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Loc[metrics.scan]}" />
                  <TextBlock Text="{Binding Loc[metrics.scan.hint]}"
                             TextWrapping="Wrap"
                             FontSize="11"
                             Opacity="0.7" />
                </StackPanel>
              </Button>

              <StackPanel Spacing="6" IsVisible="{Binding Metrics.IsScanning}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{Binding Metrics.ProgressText}" FontSize="12" />
                <Button Command="{Binding CancelDeepScanCommand}" Content="{Binding Loc[metrics.scan.cancel]}" />
              </StackPanel>

              <!-- Bar chart made of Borders: no charting dependency, and the widths come from the
                   view model (see FolderMetricBucketViewModel.BarMaxWidth, which tracks the 260px
                   of content width this 340px panel leaves after its padding). -->
              <ItemsControl ItemsSource="{Binding Metrics.Buckets}" IsVisible="{Binding Metrics.HasBuckets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderMetricBucketViewModel">
                    <StackPanel Spacing="2" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Opacity="0.8" />
                      </Grid>
                      <Border Height="6"
                              CornerRadius="3"
                              HorizontalAlignment="Left"
                              Width="{Binding BarWidth}"
                              Background="{DynamicResource AccentBrush}" />
                      <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock FontWeight="Bold" Text="{Binding Loc[metrics.largest]}" IsVisible="{Binding Metrics.HasLargestItems}" />
              <ItemsControl ItemsSource="{Binding Metrics.LargestItems}" IsVisible="{Binding Metrics.HasLargestItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LargestItemViewModel">
                    <Button Command="{Binding SelectCommand}"
                            ToolTip.Tip="{Binding Name}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,2">
                      <Grid ColumnDefinitions="*,Auto" Width="256">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Opacity="0.8" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Loc[metrics.newest]}" FontSize="12" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{Binding Metrics.NewestText}" FontSize="12" />
                <TextBlock Grid.Row="1" Text="{Binding Loc[metrics.oldest]}" FontSize="12" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Metrics.OldestText}" FontSize="12" />
              </Grid>
            </StackPanel>

            <TextBlock FontWeight="Bold" Text="{Binding Loc[metrics.scope.current]}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding CurrentPath}" />
            <TextBlock FontWeight="Bold" Text="{Binding Loc[metrics.scope.root]}" />
            <TextBlock Text="{Binding RootPath}" />
          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Grid.Row="1" Margin="16,0,16,16" Padding="12" Background="{DynamicResource ConsoleBackgroundBrush}" CornerRadius="6">
        <StackPanel Spacing="8">
          <!-- Drag handle for the console body (docs/PLAN-UX-ROUND-3.md X7). Round 1's Task 4
               asked for "panel height resizing via drag handle"; the collapse toggle shipped and
               this did not, leaving the body a hard-coded 140px. Not a GridSplitter: the console
               is not in a resizable grid row — it is an auto-sized band whose body height is a
               view-model number, so the drag adjusts that number directly. -->
          <Border x:Name="ConsoleResizeHandle"
                  Height="6"
                  CornerRadius="3"
                  Margin="0,0,0,2"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Cursor="SizeNorthSouth"
                  IsVisible="{Binding Console.IsCommandConsoleVisible}"
                  ToolTip.Tip="{Binding Loc[console.resize.tooltip]}"
                  AutomationProperties.Name="{Binding Loc[console.resize.tooltip]}" />

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}">
            <ProgressBar Width="120" IsIndeterminate="True" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Loc[common.loading]}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Grid.Styles>
              <Style Selector="Button.viewMode.active">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Style>
            </Grid.Styles>
            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Loc[console.title]}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Console.ActiveCommand}" />
            <TextBox Grid.Column="2"
                      Width="160"
                      PlaceholderText="{Binding Loc[console.search.placeholder]}"
                      AutomationProperties.Name="{Binding Loc[console.search.placeholder]}"
                      Text="{Binding Console.LogSearchText, Mode=TwoWay}" />
            <Button Grid.Column="3"
                    Classes="viewMode"
                    Classes.active="{Binding Console.ShowOnlyWarningsAndErrors}"
                    Command="{Binding Console.ToggleLogFilterCommand}"
                    ToolTip.Tip="{Binding Loc[console.warningsonly.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[console.warningsonly.tooltip]}">
              <Path Classes="icon" Data="{StaticResource IconWarning}" />
            </Button>
            <Button Grid.Column="4"
                    Command="{Binding Console.ToggleCommandConsoleCommand}"
                    ToolTip.Tip="{Binding Console.CommandConsoleToggleLabel}">
              <TextBlock Text="{Binding Console.CommandConsoleToggleGlyph}" />
            </Button>
            <Button Grid.Column="5"
                    Command="{Binding Console.DownloadActivityCommand}"
                    ToolTip.Tip="{Binding Loc[console.download.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[console.download.tooltip]}">
              <Path Classes="icon" Data="{StaticResource IconSave}" />
            </Button>
            <Button Grid.Column="6"
                    Command="{Binding Console.ClearActivityCommand}"
                    ToolTip.Tip="{Binding Loc[console.clear.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[console.clear.tooltip]}">
              <Path Classes="icon" Data="{StaticResource IconClear}" />
            </Button>
          </Grid>

          <!-- Persistent floating status line (docs/INTERFACE_IMPROVEMENT_PLAN.md Task 4): a real
               in-flight operation count and the last log line, visible only while the console body
               below is collapsed. No transfer-rate figure — nothing in the activity feed reports
               bytes/sec today, and inventing one would be exactly what AGENTS.md's "Never invent
               CLI output shapes" warns against. -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      IsVisible="{Binding !Console.IsCommandConsoleVisible}">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.8"
                       Text="{Binding Console.ActiveOperationsText}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.5"
                       Text="·" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Console.LastLogLine}"
                       IsVisible="{Binding Console.LastLogLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <Border MaxHeight="{Binding Console.CommandConsoleMaxHeight}"
                  Opacity="{Binding Console.CommandConsoleOpacity}"
                  IsHitTestVisible="{Binding Console.CommandConsoleHitTestVisible}"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="MaxHeight" Duration="0:0:0.35" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
              </Transitions>
            </Border.Transitions>
            <!-- NoWrap, with horizontal scrolling, is a deliberate performance choice as much as a
                 stylistic one. Wrapping forced Avalonia to shape and wrap the console's entire text
                 on every update: a captured stack during a 30-second UI hang was TextBlock.Measure
                 -> TextLayout.CreateTextLines -> HarfBuzzTextShaper.ShapeText. Long lines are also
                 easier to read unwrapped in a console, and CommandLogBuffer now caps their length. -->
            <ScrollViewer Height="{Binding Console.CommandConsoleHeight}" HorizontalScrollBarVisibility="Auto">
              <TextBlock TextWrapping="NoWrap" Text="{Binding Console.CommandLogText}" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!--
        The text viewer, as a panel over the listing rather than a separate window: it can't get
        lost behind the main window, and closing it is a view-model flag instead of window plumbing
        in code-behind. Covers row 1 only, so the breadcrumbs above and the CLI activity log below
        stay visible while a file is open.
      -->
      <Border Grid.Row="0"
              Margin="16,0,16,16"
              Padding="16"
              CornerRadius="6"
              Background="{DynamicResource PanelBackgroundBrush}"
              IsVisible="{Binding IsViewerVisible}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding ViewerTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="12" Opacity="0.7" Text="{Binding ViewerPath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Only images and PDF pages can be too big for the panel — the text viewer sizes by
                 font, not by a decoded bitmap, so it has nothing for this to scale. -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasViewerZoomableContent}">
              <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="{Binding Loc[viewer.zoom.label]}" />
              <!-- Named so the code-behind can commit the value when the drag ends: the setter no
                   longer writes settings.json on every tick (docs/PLAN-UX-ROUND-4.md Y6). -->
              <Slider x:Name="ViewerZoomSlider"
                      Width="140"
                      VerticalAlignment="Center"
                      Minimum="0.25"
                      Maximum="1.5"
                      SmallChange="0.05"
                      LargeChange="0.25"
                      Value="{Binding ViewerZoom, Mode=TwoWay}" />
              <TextBlock VerticalAlignment="Center"
                         FontSize="12"
                         Opacity="0.7"
                         Width="36"
                         Text="{Binding ViewerZoom, StringFormat={}{0:P0}}" />
            </StackPanel>

            <Button Grid.Column="2"
                    VerticalAlignment="Top"
                    Command="{Binding CloseViewerCommand}"
                    ToolTip.Tip="{Binding Loc[viewer.close.tooltip]}"
                    AutomationProperties.Name="{Binding Loc[viewer.close.tooltip]}">
              <Path Classes="icon" Data="{StaticResource IconClear}" />
            </Button>
          </Grid>

          <TextBlock Grid.Row="1"
                     FontSize="12"
                     Opacity="0.8"
                     TextWrapping="Wrap"
                     Text="{Binding ViewerNote}"
                     IsVisible="{Binding ViewerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsViewerLoading}">
            <ProgressBar Width="120" IsIndeterminate="True" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Loc[viewer.loading]}" />
          </StackPanel>

          <!-- NoWrap with horizontal scrolling, for the same reason as the CLI console above:
               wrapping re-shapes the whole text on every change, and a preview can be a megabyte.
               SelectableTextBlock rather than a read-only TextBox so the text can be copied without
               dragging a full editor into the view. -->
          <Border Grid.Row="3"
                  Padding="12"
                  CornerRadius="4"
                  Background="{DynamicResource ConsoleBackgroundBrush}"
                  IsVisible="{Binding HasViewerText}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock FontFamily="monospace"
                                   FontSize="13"
                                   TextWrapping="NoWrap"
                                   Text="{Binding ViewerText}" />
            </ScrollViewer>
          </Border>

          <!-- The image counterpart: Stretch="Uniform" so a huge photo fits the panel instead of
               overflowing it, and the ScrollViewer stays available for the rare image bigger than
               the panel even at that scale (a very tall panorama, say). LayoutTransformControl
               applies ViewerZoom by re-measuring, not just re-painting — a bare RenderTransform
               would scale the pixels but leave the ScrollViewer's extent (and so how much you have
               to scroll) exactly as big as the untransformed content. -->
          <Border Grid.Row="3"
                  Padding="12"
                  CornerRadius="4"
                  Background="{DynamicResource ConsoleBackgroundBrush}"
                  IsVisible="{Binding HasViewerImage}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <LayoutTransformControl LayoutTransform="{Binding ViewerZoom, Converter={x:Static conv:DoubleToScaleTransformConverter.Instance}}">
                <Image Source="{Binding ViewerImageBytes, Converter={x:Static conv:BytesToBitmapConverter.Instance}}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
              </LayoutTransformControl>
            </ScrollViewer>
          </Border>

          <!-- The PDF counterpart: every rendered page stacked in one vertical scroller — the PDFs
               this app's own users actually preview are short (a monthly invoice, a couple of
               pages), so a pager control would be more UI than the common case needs.
               ViewerPdfPages is converted to a list of decoded Bitmaps up front
               (PdfPagesToBitmapsConverter) so the item template's x:DataType can be the well-known
               Bitmap type and stay on compiled bindings — a template over a bare byte[] item has no
               x:DataType to declare, which would otherwise force reflection bindings and trip the
               AOT/trim analyzer (see PdfPagesToBitmapsConverter's own doc comment). -->
          <Border Grid.Row="3"
                  Padding="12"
                  CornerRadius="4"
                  Background="{DynamicResource ConsoleBackgroundBrush}"
                  IsVisible="{Binding HasViewerPdf}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <LayoutTransformControl LayoutTransform="{Binding ViewerZoom, Converter={x:Static conv:DoubleToScaleTransformConverter.Instance}}">
                <ItemsControl ItemsSource="{Binding ViewerPdfPages, Converter={x:Static conv:PdfPagesToBitmapsConverter.Instance}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="Bitmap">
                      <Image Source="{Binding}"
                             Stretch="Uniform"
                             HorizontalAlignment="Center" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </LayoutTransformControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Settings view: CLI connection, preferences and local directory sync, in one place instead of stacked dialogs. -->
    <ScrollViewer Grid.Row="3" IsVisible="{Binding IsSettingsView}">
      <StackPanel Margin="16" Spacing="24">
        <!-- General Preferences: Theme, Bandwidth throttle, Default sync folder -->
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Loc[settings.general.title]}" />
          <Border Padding="16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
            <StackPanel Spacing="14">
              <!-- Interface language. A ComboBox rather than the theme row's button group: two
                   buttons would be fine at two languages and wrong at five, and this is the one
                   control the whole localization change exists to add (docs/PLAN-I18N.md §4). -->
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.language.label]}" />
                <ComboBox Width="200"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          ToolTip.Tip="{Binding Loc[settings.language.tooltip]}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="loc:Language">
                      <TextBlock Text="{Binding NativeName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Theme Selection -->
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.theme.label]}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes.primary="{Binding IsSystemTheme}" Content="{Binding Loc[settings.theme.system]}" Command="{Binding SetThemeDefaultCommand}" />
                  <Button Classes.primary="{Binding IsLightTheme}" Content="{Binding Loc[settings.theme.light]}" Command="{Binding SetThemeLightCommand}" />
                  <Button Classes.primary="{Binding IsDarkTheme}" Content="{Binding Loc[settings.theme.dark]}" Command="{Binding SetThemeDarkCommand}" />
                </StackPanel>
              </StackPanel>

              <!-- Default Sync Folder -->
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.syncfolder.label]}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <!-- Stretch and no MaxWidth. A stretched control that a MaxWidth stops from
                       filling its cell is CENTRED, not left-aligned, which left this field floating
                       in the middle of the card with its browse button pinned far away
                       (docs/PLAN-UX-ROUND-3.md X7 — introduced there and found on the first
                       screenshot of the round). The field fills the row, up to its own button. -->
                  <TextBox x:Name="DefaultSyncFolderBox"
                           Grid.Column="0"
                           MinWidth="200"
                           HorizontalAlignment="Stretch"
                           PlaceholderText="{Binding Loc[settings.syncfolder.placeholder]}"
                           Text="{Binding DefaultSyncFolder, Mode=TwoWay}" />
                  <Button Grid.Column="1" ToolTip.Tip="{Binding Loc[settings.syncfolder.browse.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.syncfolder.browse.tooltip]}" Click="BrowseDefaultSyncFolder">
                    <Path Classes="icon" Data="{StaticResource IconFolder}" />
                  </Button>
                </Grid>
              </StackPanel>

              <!-- Bandwidth Throttling -->
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.bandwidth.label]}" />
                <NumericUpDown Width="200"
                               HorizontalAlignment="Left"
                               Minimum="0"
                               Maximum="1000000"
                               Increment="100"
                               FormatString="{}{0:N0} KB/s"
                               Value="{Binding BandwidthLimitKbps, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- User Settings: app-level UI preferences that aren't tied to any provider or CLI. -->
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Loc[settings.panel.title]}" />
          <Border Padding="16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
            <CheckBox Content="{Binding Loc[settings.panel.showstatus]}" IsChecked="{Binding IsStatusPanelVisible, Mode=TwoWay}" />
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Loc[settings.connection.title]}" />

          <!-- Provider picker: which backend is active, and — since U8
               (docs/PLAN-UX-ROUND-2.md §8) — which ones have a session at all. These tabs used to
               bind only Is*Active, so a provider that had never been configured looked exactly
               like a signed-in one. The ring matches the header dropdown's own auth indicator,
               the same shape for the same meaning. -->
          <!-- Wraps for the same reason as the sort row: five tabs in a fixed horizontal row run
               off the card well before the window hits its minimum width (X7). -->
          <WrapPanel Orientation="Horizontal">
            <WrapPanel.Styles>
              <Style Selector="Ellipse.providerAuth">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="Fill" Value="Transparent" />
                <Setter Property="Stroke" Value="{DynamicResource StatusOfflineBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
              <Style Selector="Ellipse.providerAuth.auth">
                <Setter Property="Stroke" Value="{DynamicResource StatusOkBrush}" />
              </Style>
            </WrapPanel.Styles>
            <Button Classes.primary="{Binding IsProtonActive}" Command="{Binding SwitchToProtonCommand}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Proton Drive" VerticalAlignment="Center" />
                <Ellipse Classes="providerAuth" Classes.auth="{Binding IsProtonAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
              </StackPanel>
            </Button>
            <Button Classes.primary="{Binding IsOneDriveActive}" Command="{Binding SwitchToOneDriveCommand}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="OneDrive" VerticalAlignment="Center" />
                <Ellipse Classes="providerAuth" Classes.auth="{Binding IsOneDriveAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
              </StackPanel>
            </Button>
            <Button Classes.primary="{Binding IsGoogleDriveActive}" Command="{Binding SwitchToGoogleDriveCommand}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Google Drive" VerticalAlignment="Center" />
                <Ellipse Classes="providerAuth" Classes.auth="{Binding IsGoogleDriveAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
              </StackPanel>
            </Button>
            <Button Classes.primary="{Binding IsNextcloudActive}" Command="{Binding SwitchToNextcloudCommand}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Nextcloud" VerticalAlignment="Center" />
                <Ellipse Classes="providerAuth" Classes.auth="{Binding IsNextcloudAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
              </StackPanel>
            </Button>
            <Button Classes.primary="{Binding IsS3Active}" Command="{Binding SwitchToS3Command}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Custom S3" VerticalAlignment="Center" />
                <Ellipse Classes="providerAuth" Classes.auth="{Binding IsS3Authenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
              </StackPanel>
            </Button>
          </WrapPanel>

          <!-- Proton's card: CLI path, auth, version, self-update. -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsProtonActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="{Binding Loc[settings.proton.clipath.label]}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <!-- See the sync-folder field above: stretch without a MaxWidth, or it centres. -->
                <TextBox Grid.Column="0"
                         MinWidth="200"
                         HorizontalAlignment="Stretch"
                         PlaceholderText="{Binding Loc[settings.proton.clipath.placeholder]}"
                         Text="{Binding CliPath, Mode=TwoWay}" />
                <Button Grid.Column="1" ToolTip.Tip="{Binding Loc[settings.proton.clipath.browse.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.proton.clipath.browse.tooltip]}" Click="BrowseCliPath">
                  <Path Classes="icon" Data="{StaticResource IconFolder}" />
                </Button>
              </Grid>

              <!-- The account row every provider card carries, in the same shape
                   (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                   three cards and a labelled button on the other two, and sign-out was always
                   visible on three and conditional on two — the same three actions reading
                   differently depending on which tab you were on. Labelled connect, because it is
                   the action a card exists for and the one a new user is looking for; icon-only
                   sign-out and refresh, which are the ones you go looking for only when you
                   already know they are there. The accent marks connect only while there is no
                   session, so it keeps meaning "do this one". -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}"
                        Command="{Binding AuthenticateCommand}"
                        ToolTip.Tip="{Binding SignInTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="{Binding Loc[auth.signin]}" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="{Binding SignOutTooltip}"
                        AutomationProperties.Name="{Binding SignOutTooltip}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding LogoutCommand}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                        AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>

              <!-- Version/self-update rows: gated on HasDiagnostics rather than a Proton-specific
                   flag, so a third provider with no external binary needs no XAML change here
                   (docs/PLAN-CLOUD-PROVIDERS.md §5 item 2) — for now that's every non-Proton
                   provider, but the binding itself doesn't know that. -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CliUpdate.HasDiagnostics}">
                <TextBlock VerticalAlignment="Center" Text="{Binding Loc[settings.proton.cliversion.label]}" />
                <TextBlock VerticalAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Text="{Binding CliUpdate.CliVersion}" />
                <Button ToolTip.Tip="{Binding Loc[settings.proton.cliversion.recheck.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.proton.cliversion.recheck.tooltip]}" Command="{Binding CliUpdate.CheckCliVersionCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CliUpdate.HasDiagnostics}">
                <TextBlock VerticalAlignment="Center" Text="{Binding Loc[settings.proton.update.label]}" />
                <TextBlock VerticalAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Text="{Binding CliUpdate.CliUpdateStatus}" />
                <Button ToolTip.Tip="{Binding Loc[settings.proton.update.check.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.proton.update.check.tooltip]}"
                        Command="{Binding CliUpdate.CheckForCliUpdateCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
                <Button Classes="primary"
                        Content="{Binding Loc[settings.proton.update.install]}"
                        IsVisible="{Binding CliUpdate.IsCliUpdateAvailable}"
                        ToolTip.Tip="{Binding Loc[settings.proton.update.install.tooltip]}"
                        Command="{Binding CliUpdate.InstallCliUpdateCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- OneDrive's card: client id, sign-in/out, account label. No CLI path, no version row
               — there is no external binary to point at or version (Diagnostics is null). -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsOneDriveActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="{Binding Loc[settings.onedrive.clientid.label]}" />
              <TextBlock Opacity="0.6"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Text="{Binding Loc[settings.onedrive.clientid.hint]}" />
              <TextBox MinWidth="200"
                       HorizontalAlignment="Stretch"
                       PlaceholderText="{Binding Loc[settings.onedrive.clientid.placeholder]}"
                       Text="{Binding OneDriveClientId, Mode=TwoWay}" />

              <!-- The account row every provider card carries, in the same shape
                   (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                   three cards and a labelled button on the other two, and sign-out was always
                   visible on three and conditional on two — the same three actions reading
                   differently depending on which tab you were on. Labelled connect, because it is
                   the action a card exists for and the one a new user is looking for; icon-only
                   sign-out and refresh, which are the ones you go looking for only when you
                   already know they are there. The accent marks connect only while there is no
                   session, so it keeps meaning "do this one". -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}"
                        Command="{Binding AuthenticateCommand}"
                        ToolTip.Tip="{Binding SignInTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="{Binding Loc[auth.signin]}" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="{Binding SignOutTooltip}"
                        AutomationProperties.Name="{Binding SignOutTooltip}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding LogoutCommand}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                        AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="{Binding Loc[common.account]}" />
                <TextBlock VerticalAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Text="{Binding OneDriveAccountLabel}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Google Drive's card: client id/secret, sign-in/out, account label. No CLI path, no
               version row — there is no external binary to point at or version (Diagnostics is null). -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsGoogleDriveActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="{Binding Loc[settings.googledrive.title]}" FontWeight="SemiBold" />
              <TextBlock Opacity="0.6"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Text="{Binding Loc[settings.googledrive.hint]}" />
              <TextBlock Text="{Binding Loc[settings.googledrive.clientid.label]}" />
              <TextBox MinWidth="200"
                       HorizontalAlignment="Stretch"
                       PlaceholderText="{Binding Loc[settings.googledrive.clientid.placeholder]}"
                       Text="{Binding GoogleDriveClientId, Mode=TwoWay}" />
              <TextBlock Text="{Binding Loc[settings.googledrive.clientsecret.label]}" />
              <TextBox MinWidth="200"
                       HorizontalAlignment="Stretch"
                       PlaceholderText="{Binding Loc[settings.googledrive.clientsecret.placeholder]}"
                       PasswordChar="*"
                       Text="{Binding GoogleDriveClientSecret, Mode=TwoWay}" />
              <!-- The account row every provider card carries, in the same shape
                   (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                   three cards and a labelled button on the other two, and sign-out was always
                   visible on three and conditional on two — the same three actions reading
                   differently depending on which tab you were on. Labelled connect, because it is
                   the action a card exists for and the one a new user is looking for; icon-only
                   sign-out and refresh, which are the ones you go looking for only when you
                   already know they are there. The accent marks connect only while there is no
                   session, so it keeps meaning "do this one". -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}"
                        Command="{Binding AuthenticateCommand}"
                        ToolTip.Tip="{Binding SignInTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="{Binding Loc[auth.signin]}" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="{Binding SignOutTooltip}"
                        AutomationProperties.Name="{Binding SignOutTooltip}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding LogoutCommand}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                        AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="{Binding Loc[common.account]}" />
                <TextBlock VerticalAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           Text="{Binding GoogleDriveAccountLabel}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Nextcloud's card -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsNextcloudActive}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="{Binding Loc[settings.nextcloud.title]}" FontWeight="SemiBold" />
              <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                         Text="{Binding Loc[settings.nextcloud.hint]}" />
              <!-- The account row every provider card carries, in the same shape
                   (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                   three cards and a labelled button on the other two, and sign-out was always
                   visible on three and conditional on two — the same three actions reading
                   differently depending on which tab you were on. Labelled connect, because it is
                   the action a card exists for and the one a new user is looking for; icon-only
                   sign-out and refresh, which are the ones you go looking for only when you
                   already know they are there. The accent marks connect only while there is no
                   session, so it keeps meaning "do this one". -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}"
                        Command="{Binding AuthenticateCommand}"
                        ToolTip.Tip="{Binding SignInTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="{Binding Loc[auth.signin]}" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="{Binding SignOutTooltip}"
                        AutomationProperties.Name="{Binding SignOutTooltip}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding LogoutCommand}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                        AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Custom S3 Storage card -->
          <Border Padding="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  CornerRadius="6"
                  IsVisible="{Binding IsS3Active}">
            <StackPanel Spacing="10">
              <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
              <TextBlock Text="{Binding Loc[settings.s3.title]}" FontWeight="SemiBold" />
              <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                         Text="{Binding Loc[settings.s3.hint]}" />
              <!-- The account row every provider card carries, in the same shape
                   (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                   three cards and a labelled button on the other two, and sign-out was always
                   visible on three and conditional on two — the same three actions reading
                   differently depending on which tab you were on. Labelled connect, because it is
                   the action a card exists for and the one a new user is looking for; icon-only
                   sign-out and refresh, which are the ones you go looking for only when you
                   already know they are there. The accent marks connect only while there is no
                   session, so it keeps meaning "do this one". -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding !IsAuthenticated}"
                        Command="{Binding AuthenticateCommand}"
                        ToolTip.Tip="{Binding SignInTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconKey}" />
                    <TextBlock Text="{Binding Loc[auth.signin]}" />
                  </StackPanel>
                </Button>
                <Button ToolTip.Tip="{Binding SignOutTooltip}"
                        AutomationProperties.Name="{Binding SignOutTooltip}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding LogoutCommand}">
                  <Path Classes="icon" Data="{StaticResource IconLogout}" />
                </Button>
                <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                        AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding RefreshCommand}">
                  <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Sync, as a sibling of the explorer and the settings scroll rather than a section buried
         inside the latter (docs/PLAN-UX-ROUND-2.md §5). The wrapper keeps the window's own
         DataContext so IsSyncView resolves against MainWindowViewModel, while the view itself
         gets the SyncPanelViewModel it is typed against. -->
    <ContentControl Grid.Row="3" IsVisible="{Binding IsSyncView}">
      <views:SyncPanelView DataContext="{Binding SyncPanel}" />
    </ContentControl>
  </Grid>
</Window>
