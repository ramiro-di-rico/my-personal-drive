<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MyPersonalDrive.ViewModels"
             xmlns:loc="using:MyPersonalDrive.Services.Localization"
             x:Class="MyPersonalDrive.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
  <!-- Settings view: CLI connection, preferences and local directory sync, in one place instead of stacked dialogs. -->
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="24">
      <!-- General Preferences: Theme, Bandwidth throttle, Default sync folder -->
      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Loc[settings.general.title]}" />
        <Border Padding="16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
          <StackPanel Spacing="14">
            <!-- Interface language. A ComboBox rather than the theme row's button group: two
                 buttons would be fine at two languages and wrong at five, and this is the one
                 control the whole localization change exists to add (docs/PLAN-I18N.md §4). -->
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.language.label]}" />
              <ComboBox Width="200"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                        ToolTip.Tip="{Binding Loc[settings.language.tooltip]}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="loc:Language">
                    <TextBlock Text="{Binding NativeName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- Theme Selection -->
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.theme.label]}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes.primary="{Binding IsSystemTheme}" Content="{Binding Loc[settings.theme.system]}" Command="{Binding SetThemeDefaultCommand}" />
                <Button Classes.primary="{Binding IsLightTheme}" Content="{Binding Loc[settings.theme.light]}" Command="{Binding SetThemeLightCommand}" />
                <Button Classes.primary="{Binding IsDarkTheme}" Content="{Binding Loc[settings.theme.dark]}" Command="{Binding SetThemeDarkCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Default Sync Folder -->
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.syncfolder.label]}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <!-- Stretch and no MaxWidth. A stretched control that a MaxWidth stops from
                     filling its cell is CENTRED, not left-aligned, which left this field floating
                     in the middle of the card with its browse button pinned far away
                     (docs/PLAN-UX-ROUND-3.md X7 — introduced there and found on the first
                     screenshot of the round). The field fills the row, up to its own button. -->
                <TextBox x:Name="DefaultSyncFolderBox"
                         Grid.Column="0"
                         MinWidth="200"
                         HorizontalAlignment="Stretch"
                         PlaceholderText="{Binding Loc[settings.syncfolder.placeholder]}"
                         Text="{Binding DefaultSyncFolder, Mode=TwoWay}" />
                <Button Grid.Column="1" ToolTip.Tip="{Binding Loc[settings.syncfolder.browse.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.syncfolder.browse.tooltip]}" Click="BrowseDefaultSyncFolder">
                  <Path Classes="icon" Data="{StaticResource IconFolder}" />
                </Button>
              </Grid>
            </StackPanel>

            <!-- Bandwidth Throttling -->
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="{Binding Loc[settings.bandwidth.label]}" />
              <NumericUpDown Width="200"
                             HorizontalAlignment="Left"
                             Minimum="0"
                             Maximum="1000000"
                             Increment="100"
                             FormatString="{}{0:N0} KB/s"
                             Value="{Binding BandwidthLimitKbps, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- User Settings: app-level UI preferences that aren't tied to any provider or CLI. -->
      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Loc[settings.panel.title]}" />
        <Border Padding="16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
          <CheckBox Content="{Binding Loc[settings.panel.showstatus]}" IsChecked="{Binding IsStatusPanelVisible, Mode=TwoWay}" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Loc[settings.connection.title]}" />

        <!-- Provider picker: which backend is active, and — since U8
             (docs/PLAN-UX-ROUND-2.md §8) — which ones have a session at all. These tabs used to
             bind only Is*Active, so a provider that had never been configured looked exactly
             like a signed-in one. The ring matches the header dropdown's own auth indicator,
             the same shape for the same meaning. -->
        <!-- Wraps for the same reason as the sort row: five tabs in a fixed horizontal row run
             off the card well before the window hits its minimum width (X7). -->
        <WrapPanel Orientation="Horizontal">
          <WrapPanel.Styles>
            <Style Selector="Ellipse.providerAuth">
              <Setter Property="Width" Value="8" />
              <Setter Property="Height" Value="8" />
              <Setter Property="StrokeThickness" Value="2" />
              <Setter Property="Fill" Value="Transparent" />
              <Setter Property="Stroke" Value="{DynamicResource StatusOfflineBrush}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Ellipse.providerAuth.auth">
              <Setter Property="Stroke" Value="{DynamicResource StatusOkBrush}" />
            </Style>
          </WrapPanel.Styles>
          <Button Classes.primary="{Binding IsProtonActive}" Command="{Binding SwitchToProtonCommand}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Proton Drive" VerticalAlignment="Center" />
              <Ellipse Classes="providerAuth" Classes.auth="{Binding IsProtonAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
            </StackPanel>
          </Button>
          <Button Classes.primary="{Binding IsOneDriveActive}" Command="{Binding SwitchToOneDriveCommand}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="OneDrive" VerticalAlignment="Center" />
              <Ellipse Classes="providerAuth" Classes.auth="{Binding IsOneDriveAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
            </StackPanel>
          </Button>
          <Button Classes.primary="{Binding IsGoogleDriveActive}" Command="{Binding SwitchToGoogleDriveCommand}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Google Drive" VerticalAlignment="Center" />
              <Ellipse Classes="providerAuth" Classes.auth="{Binding IsGoogleDriveAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
            </StackPanel>
          </Button>
          <Button Classes.primary="{Binding IsNextcloudActive}" Command="{Binding SwitchToNextcloudCommand}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Nextcloud" VerticalAlignment="Center" />
              <Ellipse Classes="providerAuth" Classes.auth="{Binding IsNextcloudAuthenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
            </StackPanel>
          </Button>
          <Button Classes.primary="{Binding IsS3Active}" Command="{Binding SwitchToS3Command}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Custom S3" VerticalAlignment="Center" />
              <Ellipse Classes="providerAuth" Classes.auth="{Binding IsS3Authenticated}" ToolTip.Tip="{Binding Loc[settings.provider.signedin.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.provider.signedin.tooltip]}" />
            </StackPanel>
          </Button>
        </WrapPanel>

        <!-- Proton's card: CLI path, auth, version, self-update. -->
        <Border Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="6"
                IsVisible="{Binding IsProtonActive}">
          <StackPanel Spacing="10">
            <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
            <TextBlock Text="{Binding Loc[settings.proton.clipath.label]}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <!-- See the sync-folder field above: stretch without a MaxWidth, or it centres. -->
              <TextBox Grid.Column="0"
                       MinWidth="200"
                       HorizontalAlignment="Stretch"
                       PlaceholderText="{Binding Loc[settings.proton.clipath.placeholder]}"
                       Text="{Binding CliPath, Mode=TwoWay}" />
              <Button Grid.Column="1" ToolTip.Tip="{Binding Loc[settings.proton.clipath.browse.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.proton.clipath.browse.tooltip]}" Click="BrowseCliPath">
                <Path Classes="icon" Data="{StaticResource IconFolder}" />
              </Button>
            </Grid>

            <!-- The account row every provider card carries, in the same shape
                 (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                 three cards and a labelled button on the other two, and sign-out was always
                 visible on three and conditional on two — the same three actions reading
                 differently depending on which tab you were on. Labelled connect, because it is
                 the action a card exists for and the one a new user is looking for; icon-only
                 sign-out and refresh, which are the ones you go looking for only when you
                 already know they are there. The accent marks connect only while there is no
                 session, so it keeps meaning "do this one". -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes.primary="{Binding !IsAuthenticated}"
                      Command="{Binding AuthenticateCommand}"
                      ToolTip.Tip="{Binding SignInTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconKey}" />
                  <TextBlock Text="{Binding Loc[auth.signin]}" />
                </StackPanel>
              </Button>
              <Button ToolTip.Tip="{Binding SignOutTooltip}"
                      AutomationProperties.Name="{Binding SignOutTooltip}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding LogoutCommand}">
                <Path Classes="icon" Data="{StaticResource IconLogout}" />
              </Button>
              <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding RefreshCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </StackPanel>

            <!-- Version/self-update rows: gated on HasDiagnostics rather than a Proton-specific
                 flag, so a third provider with no external binary needs no XAML change here
                 (docs/PLAN-CLOUD-PROVIDERS.md §5 item 2) — for now that's every non-Proton
                 provider, but the binding itself doesn't know that. -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CliUpdate.HasDiagnostics}">
              <TextBlock VerticalAlignment="Center" Text="{Binding Loc[settings.proton.cliversion.label]}" />
              <TextBlock VerticalAlignment="Center"
                         MaxWidth="420"
                         TextWrapping="Wrap"
                         Opacity="0.8"
                         Text="{Binding CliUpdate.CliVersion}" />
              <Button ToolTip.Tip="{Binding Loc[settings.proton.cliversion.recheck.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.proton.cliversion.recheck.tooltip]}" Command="{Binding CliUpdate.CheckCliVersionCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CliUpdate.HasDiagnostics}">
              <TextBlock VerticalAlignment="Center" Text="{Binding Loc[settings.proton.update.label]}" />
              <TextBlock VerticalAlignment="Center"
                         MaxWidth="420"
                         TextWrapping="Wrap"
                         Opacity="0.8"
                         Text="{Binding CliUpdate.CliUpdateStatus}" />
              <Button ToolTip.Tip="{Binding Loc[settings.proton.update.check.tooltip]}" AutomationProperties.Name="{Binding Loc[settings.proton.update.check.tooltip]}"
                      Command="{Binding CliUpdate.CheckForCliUpdateCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
              <Button Classes="primary"
                      Content="{Binding Loc[settings.proton.update.install]}"
                      IsVisible="{Binding CliUpdate.IsCliUpdateAvailable}"
                      ToolTip.Tip="{Binding Loc[settings.proton.update.install.tooltip]}"
                      Command="{Binding CliUpdate.InstallCliUpdateCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- OneDrive's card: client id, sign-in/out, account label. No CLI path, no version row
             — there is no external binary to point at or version (Diagnostics is null). -->
        <Border Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="6"
                IsVisible="{Binding IsOneDriveActive}">
          <StackPanel Spacing="10">
            <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
            <TextBlock Text="{Binding Loc[settings.onedrive.clientid.label]}" />
            <TextBlock Opacity="0.6"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{Binding Loc[settings.onedrive.clientid.hint]}" />
            <TextBox MinWidth="200"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="{Binding Loc[settings.onedrive.clientid.placeholder]}"
                     Text="{Binding OneDriveClientId, Mode=TwoWay}" />

            <!-- The account row every provider card carries, in the same shape
                 (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                 three cards and a labelled button on the other two, and sign-out was always
                 visible on three and conditional on two — the same three actions reading
                 differently depending on which tab you were on. Labelled connect, because it is
                 the action a card exists for and the one a new user is looking for; icon-only
                 sign-out and refresh, which are the ones you go looking for only when you
                 already know they are there. The accent marks connect only while there is no
                 session, so it keeps meaning "do this one". -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes.primary="{Binding !IsAuthenticated}"
                      Command="{Binding AuthenticateCommand}"
                      ToolTip.Tip="{Binding SignInTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconKey}" />
                  <TextBlock Text="{Binding Loc[auth.signin]}" />
                </StackPanel>
              </Button>
              <Button ToolTip.Tip="{Binding SignOutTooltip}"
                      AutomationProperties.Name="{Binding SignOutTooltip}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding LogoutCommand}">
                <Path Classes="icon" Data="{StaticResource IconLogout}" />
              </Button>
              <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding RefreshCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock VerticalAlignment="Center" Text="{Binding Loc[common.account]}" />
              <TextBlock VerticalAlignment="Center"
                         MaxWidth="420"
                         TextWrapping="Wrap"
                         Opacity="0.8"
                         Text="{Binding OneDriveAccountLabel}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Google Drive's card: client id/secret, sign-in/out, account label. No CLI path, no
             version row — there is no external binary to point at or version (Diagnostics is null). -->
        <Border Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="6"
                IsVisible="{Binding IsGoogleDriveActive}">
          <StackPanel Spacing="10">
            <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
            <TextBlock Text="{Binding Loc[settings.googledrive.title]}" FontWeight="SemiBold" />
            <TextBlock Opacity="0.6"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{Binding Loc[settings.googledrive.hint]}" />
            <TextBlock Text="{Binding Loc[settings.googledrive.clientid.label]}" />
            <TextBox MinWidth="200"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="{Binding Loc[settings.googledrive.clientid.placeholder]}"
                     Text="{Binding GoogleDriveClientId, Mode=TwoWay}" />
            <TextBlock Text="{Binding Loc[settings.googledrive.clientsecret.label]}" />
            <TextBox MinWidth="200"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="{Binding Loc[settings.googledrive.clientsecret.placeholder]}"
                     PasswordChar="*"
                     Text="{Binding GoogleDriveClientSecret, Mode=TwoWay}" />
            <!-- The account row every provider card carries, in the same shape
                 (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                 three cards and a labelled button on the other two, and sign-out was always
                 visible on three and conditional on two — the same three actions reading
                 differently depending on which tab you were on. Labelled connect, because it is
                 the action a card exists for and the one a new user is looking for; icon-only
                 sign-out and refresh, which are the ones you go looking for only when you
                 already know they are there. The accent marks connect only while there is no
                 session, so it keeps meaning "do this one". -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes.primary="{Binding !IsAuthenticated}"
                      Command="{Binding AuthenticateCommand}"
                      ToolTip.Tip="{Binding SignInTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconKey}" />
                  <TextBlock Text="{Binding Loc[auth.signin]}" />
                </StackPanel>
              </Button>
              <Button ToolTip.Tip="{Binding SignOutTooltip}"
                      AutomationProperties.Name="{Binding SignOutTooltip}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding LogoutCommand}">
                <Path Classes="icon" Data="{StaticResource IconLogout}" />
              </Button>
              <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding RefreshCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock VerticalAlignment="Center" Text="{Binding Loc[common.account]}" />
              <TextBlock VerticalAlignment="Center"
                         MaxWidth="420"
                         TextWrapping="Wrap"
                         Opacity="0.8"
                         Text="{Binding GoogleDriveAccountLabel}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Nextcloud's card -->
        <Border Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="6"
                IsVisible="{Binding IsNextcloudActive}">
          <StackPanel Spacing="10">
            <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
            <TextBlock Text="{Binding Loc[settings.nextcloud.title]}" FontWeight="SemiBold" />
            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="{Binding Loc[settings.nextcloud.hint]}" />
            <!-- The account row every provider card carries, in the same shape
                 (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                 three cards and a labelled button on the other two, and sign-out was always
                 visible on three and conditional on two — the same three actions reading
                 differently depending on which tab you were on. Labelled connect, because it is
                 the action a card exists for and the one a new user is looking for; icon-only
                 sign-out and refresh, which are the ones you go looking for only when you
                 already know they are there. The accent marks connect only while there is no
                 session, so it keeps meaning "do this one". -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes.primary="{Binding !IsAuthenticated}"
                      Command="{Binding AuthenticateCommand}"
                      ToolTip.Tip="{Binding SignInTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconKey}" />
                  <TextBlock Text="{Binding Loc[auth.signin]}" />
                </StackPanel>
              </Button>
              <Button ToolTip.Tip="{Binding SignOutTooltip}"
                      AutomationProperties.Name="{Binding SignOutTooltip}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding LogoutCommand}">
                <Path Classes="icon" Data="{StaticResource IconLogout}" />
              </Button>
              <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding RefreshCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Custom S3 Storage card -->
        <Border Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="6"
                IsVisible="{Binding IsS3Active}">
          <StackPanel Spacing="10">
            <TextBlock Opacity="0.7" Text="{Binding ActiveProviderDisplayName}" />
            <TextBlock Text="{Binding Loc[settings.s3.title]}" FontWeight="SemiBold" />
            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="{Binding Loc[settings.s3.hint]}" />
            <!-- The account row every provider card carries, in the same shape
                 (docs/PLAN-UX-ROUND-3.md X10). Connect used to be an icon-only key button on
                 three cards and a labelled button on the other two, and sign-out was always
                 visible on three and conditional on two — the same three actions reading
                 differently depending on which tab you were on. Labelled connect, because it is
                 the action a card exists for and the one a new user is looking for; icon-only
                 sign-out and refresh, which are the ones you go looking for only when you
                 already know they are there. The accent marks connect only while there is no
                 session, so it keeps meaning "do this one". -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes.primary="{Binding !IsAuthenticated}"
                      Command="{Binding AuthenticateCommand}"
                      ToolTip.Tip="{Binding SignInTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconKey}" />
                  <TextBlock Text="{Binding Loc[auth.signin]}" />
                </StackPanel>
              </Button>
              <Button ToolTip.Tip="{Binding SignOutTooltip}"
                      AutomationProperties.Name="{Binding SignOutTooltip}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding LogoutCommand}">
                <Path Classes="icon" Data="{StaticResource IconLogout}" />
              </Button>
              <Button ToolTip.Tip="{Binding Loc[settings.refresh.tooltip]}"
                      AutomationProperties.Name="{Binding Loc[settings.refresh.tooltip]}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding RefreshCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
